;;; fanyi-buffer-state-tests.el --- Reader configuration across queries -*- lexical-binding: t; -*-

(require 'fanyi-test-support)
(require 'face-remap)

(define-derived-mode fanyi-test-derived-mode fanyi-mode "Fanyi test")

(ert-deftest fanyi-query-preserves-derived-mode-and-local-reader-settings ()
  (fanyi-test--with-query
    (let* ((mode-runs 0)
           (fanyi-mode-hook (list (lambda () (cl-incf mode-runs)))))
      (with-current-buffer (get-buffer-create fanyi-buffer-name)
        (fanyi-test-derived-mode)
        (setq-local shr-width 37)
        (setq-local fanyi-use-glyphs nil)
        (text-scale-set 2)
        (visual-line-mode 1)
        (cl-labels ((check ()
                      (should (eq major-mode 'fanyi-test-derived-mode))
                      (should (= shr-width 37))
                      (should-not fanyi-use-glyphs)
                      (should (= text-scale-mode-amount 2))
                      (should visual-line-mode)
                      (should (= mode-runs 1))))
          (dolist (word '("first" "second"))
            (fanyi-dwim word)
            (fanyi-test--respond (car (last fanyi-test--requests)))
            (check)
            (should (= fanyi--tasks-completed 1)))
          (fanyi-back)
          (check)
          (fanyi-forward)
          (check)
          (fanyi--revert-buffer nil t)
          (check)
          (should (= fanyi--tasks-completed 0))
          (should (= (length fanyi--tasks) 1))
          (fanyi-test--respond (car (last fanyi-test--requests)))
          (should (= fanyi--tasks-completed 1)))))))

(ert-deftest fanyi-query-updates-late-provider-highlighting-without-losing-user-rules ()
  (fanyi-test--with-query
    (setq fanyi-buffer-name (generate-new-buffer-name "fanyi-test-settings"))
    (let ((fanyi-mode-font-lock-keywords-extra nil))
      (fanyi-dwim "first")
      (fanyi-test--respond (car fanyi-test--requests))
      (with-current-buffer fanyi-buffer-name
        (font-lock-add-keywords nil '(("CUSTOM" . font-lock-warning-face)) 'append)
        (setq fanyi-mode-font-lock-keywords-extra '(("LATE" . font-lock-string-face)))
        (fanyi-dwim "second")
        (fanyi-test--respond (cadr fanyi-test--requests) nil "CUSTOM LATE")
        (fanyi-test--fontify)
        (goto-char (point-min))
        (search-forward "CUSTOM")
        (should (eq (get-text-property (match-beginning 0) 'face) 'font-lock-warning-face))
        (search-forward "LATE")
        (should (eq (get-text-property (match-beginning 0) 'face) 'font-lock-string-face))))))

(provide 'fanyi-buffer-state-tests)
;;; fanyi-buffer-state-tests.el ends here
