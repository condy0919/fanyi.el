;;; fanyi-youdao-ui-tests.el --- Youdao entry layout and interaction -*- lexical-binding: t; -*-

(require 'fanyi-test-support)
(require 'fanyi-youdao-thesaurus)

(defconst fanyi-youdao-test--entries
  '(("sample" . "n. 样本；例子；vt. 取样；尝试")
    ("specimen" . "n. 标本；样本；供研究、观察和比较的实例，有时也指一个具有代表性的事物。")
    ("representative sample" . "NO EXPLANATION")))

(ert-deftest fanyi-youdao-ui-aligns-entries-and-wraps-explanations ()
  (fanyi-test--with-result-buffer
    (let ((shr-width 80)
          (fanyi-youdao-thesaurus-layout 'columns)
          (inhibit-read-only t)
          (before (copy-tree fanyi-youdao-test--entries)))
      (fanyi-youdao-thesaurus-render fanyi-youdao-test--entries nil)
      (should (equal before fanyi-youdao-test--entries))
      (should (string-match-p "^sample[ ]+n\\. 样本；例子\n[ ]+vt\\. 取样；尝试" (buffer-string)))
      (should (string-match-p "^representative sample[ ]+暂无释义" (buffer-string)))
      (goto-char (point-min))
      (search-forward "n. 样本")
      (let ((column (- (current-column) (string-width "n. 样本"))))
        (search-forward "vt. 取样")
        (should (= column (- (current-column) (string-width "vt. 取样"))))
        (search-forward "n. 标本")
        (should (= column (- (current-column) (string-width "n. 标本"))))
        (forward-line 1)
        (should (= (current-indentation) column)))
      (should (<= (fanyi-shr-test--max-line-width) 80))
      (should (equal (fanyi-test--button-data #'fanyi-dwim)
                     '("sample" "specimen" "representative sample"))))))

(ert-deftest fanyi-youdao-ui-keeps-semantic-faces-and-query-actions ()
  (fanyi-test--with-result-buffer
    (let ((inhibit-read-only t) queries)
      (fanyi-youdao-thesaurus-render fanyi-youdao-test--entries nil)
      (fanyi-test--fontify)
      (goto-char (point-min))
      (search-forward "sample")
      (let ((position (match-beginning 0)))
        (should (eq (get-text-property position 'font-lock-face) 'fanyi-youdao-thesaurus-word-face))
        (should (memq 'fanyi-youdao-thesaurus-word-face
                      (ensure-list (get-char-property position 'face))))
        (should (button-at position)))
      (search-forward "n. 样本")
      (should (eq (get-char-property (match-beginning 0) 'face) 'fanyi-pos-face))
      (search-forward "暂无释义")
      (should (eq (get-char-property (match-beginning 0) 'face) 'shadow))
      (cl-letf (((symbol-function 'fanyi-dwim) (lambda (word) (push word queries))))
        (goto-char (point-min))
        (search-forward "representative sample")
        (goto-char (match-beginning 0))
        (call-interactively (key-binding (kbd "RET"))))
      (should (equal queries '("representative sample"))))))

(ert-deftest fanyi-youdao-ui-reflows-without-fetching-and-preserves-reading-state ()
  (fanyi-test--with-result-buffer
    (save-window-excursion
      (set-window-buffer nil (current-buffer))
      (let ((inhibit-read-only t)
            (fanyi-youdao-thesaurus-layout 'columns)
            (shr-width 80))
        (insert "Earlier dictionary\n\n")
        (fanyi-youdao-thesaurus-render fanyi-youdao-test--entries nil)
        (insert "Later dictionary\n")
        (goto-char (point-min))
        (search-forward "样本；例子")
        (set-mark (match-beginning 0))
        (let* ((region (car fanyi-shr--regions))
               (dom (fanyi-shr--region-dom region))
               (selected (buffer-substring-no-properties (mark) (point)))
               (transient-mark-mode t) (mark-active t) (deactivate-mark nil))
          (cl-letf (((symbol-function 'url-retrieve) (lambda (&rest _) (ert-fail "No network"))))
            (dolist (width '(32 70 35))
              (let ((shr-width width))
                (fanyi-shr-reflow)
                (should (eq dom (fanyi-shr--region-dom region)))
                (should (use-region-p))
                (should (equal selected (buffer-substring-no-properties (mark) (point))))
                (should (string-prefix-p "Earlier dictionary\n\n" (buffer-string)))
                (should (string-suffix-p "Later dictionary\n" (buffer-string)))
                (should (<= (fanyi-shr-test--max-line-width) width))
                (should (equal (fanyi-test--button-data #'fanyi-dwim)
                               '("sample" "specimen" "representative sample")))
                (if (< width 54)
                    (should (string-match-p "^sample\n  n\\. 样本" (buffer-string)))
                  (should (string-match-p "^sample[ ]+n\\. 样本" (buffer-string)))))))
          (let ((fanyi-youdao-thesaurus-layout 'stacked)
                (fanyi-youdao-thesaurus-indent 4))
            (fanyi-shr--post-command)
            (should (string-match-p "^sample\n    n\\. 样本" (buffer-string)))))))))

(ert-deftest fanyi-youdao-ui-splits-only-explicit-part-of-speech-boundaries ()
  (fanyi-test--with-result-buffer
    (let ((inhibit-read-only t)
          (fanyi-youdao-thesaurus-layout 'stacked)
          (shr-width 80))
      (fanyi-youdao-thesaurus-render
       '(("word" . "\n  n. first; second；n.example；n._suffix；N. text；adj. next；(adv.) finally\n")) nil)
      (should (string-match-p "n\\. first; second；n\\.example；n\\._suffix；N\\. text\n  adj\\. next\n  (adv\\.) finally"
                              (buffer-string)))
      (fanyi-test--fontify)
      (goto-char (point-min))
      (dolist (text '("n.example" "n._suffix" "N."))
        (search-forward text)
        (should-not (get-char-property (match-beginning 0) 'font-lock-face))))))

(ert-deftest fanyi-youdao-ui-wraps-long-words-as-complete-query-buttons ()
  (let* ((words (list "a representative sample of the population"
                      (concat "abcdefghijklmnopqrstuvwxyz" "ABCDEFGHIJKLMNOPQRSTUVWXYZ" "0123456789")
                      "一个用于代表总体情况并且需要在窄窗口中换行显示的中文词组"))
         (entries (mapcar (lambda (word) (cons word "n. 样本；vt. 取样")) words))
         (original (copy-tree entries t)))
    (dolist (layout '(columns stacked))
      (fanyi-test--with-result-buffer
        (let ((shr-width 32)
              (fanyi-youdao-thesaurus-layout layout)
              (inhibit-read-only t) queries)
          (fanyi-youdao-thesaurus-render entries nil)
          (fanyi-test--fontify)
          (should (equal entries original))
          (should (<= (fanyi-shr-test--max-line-width) 32))
          (should (equal (fanyi-test--button-data #'fanyi-dwim) words))
          (let ((button (next-button (point-min))))
            (dolist (word words)
              (let ((text (buffer-substring-no-properties (button-start button) (button-end button))))
                (should (string-match-p "\n" text))
                (should (equal (replace-regexp-in-string "[ \t\r\n]+" "" text)
                               (replace-regexp-in-string "[ \t\r\n]+" "" word))))
              ;; Every continuation belongs to the same button and keeps its face.
              (goto-char (button-start button))
              (while (search-forward "\n" (button-end button) t)
                (should (= (button-start (button-at (point))) (button-start button)))
                (should (= (button-end (button-at (point))) (button-end button)))
                (should (eq (get-text-property (point) 'font-lock-face)
                            'fanyi-youdao-thesaurus-word-face)))
              (cl-letf (((symbol-function 'fanyi-dwim) (lambda (query) (push query queries))))
                (goto-char (1- (button-end button)))
                (call-interactively (key-binding (kbd "RET"))))
              (goto-char (button-end button))
              (search-forward "n. 样本")
              (should (eq (get-char-property (match-beginning 0) 'face) 'fanyi-pos-face))
              (setq button (next-button (button-end button)))))
          (should (equal (nreverse queries) words)))))))

(ert-deftest fanyi-youdao-ui-reflows-wrapped-words-without-losing-selection-or-text ()
  (fanyi-test--with-result-buffer
    (save-window-excursion
      (set-window-buffer nil (current-buffer))
      (let* ((word "a representative sample of the population")
             (fanyi-youdao-thesaurus-layout 'columns)
             (shr-width 80)
             (inhibit-read-only t))
        (fanyi-youdao-thesaurus-render (list (cons word "n. 样本；vt. 取样")) nil)
        (goto-char (point-min))
        (search-forward "population")
        (set-mark (match-beginning 0))
        (let ((dom (fanyi-shr--region-dom (car fanyi-shr--regions)))
              (content (replace-regexp-in-string "[ \t\r\n]+" "" (buffer-string)))
              (transient-mark-mode t) (mark-active t) (deactivate-mark nil))
          (cl-letf (((symbol-function 'url-retrieve) (lambda (&rest _) (ert-fail "No network"))))
            (dolist (width '(32 24 80))
              (let ((shr-width width))
                (fanyi-shr-reflow)
                (should (eq dom (fanyi-shr--region-dom (car fanyi-shr--regions))))
                (should (use-region-p))
                (should (equal (buffer-substring-no-properties (mark) (point)) "population"))
                (should (equal (replace-regexp-in-string "[ \t\r\n]+" "" (buffer-string)) content))
                (should (<= (fanyi-shr-test--max-line-width) width))
                (should (equal (fanyi-test--button-data #'fanyi-dwim) (list word)))))))))))

(ert-deftest fanyi-youdao-ui-bounds-long-explanations-and-large-indentation ()
  (let* ((long-word "antidisestablishmentarianismabcdefghijklmnopqrstuvwxyz")
         (chinese "一个需要在窄窗口中完整换行并保持词性高亮的中文释义。")
         (entries `(("word" . ,(concat "n. " long-word "；vt. " chinese))
                    ("missing" . "NO EXPLANATION")))
         (before (copy-tree entries t)))
    (dolist (layout '(columns stacked))
      (dolist (width '(24 48))
        (dolist (indent '(2 30))
          (ert-info ((format "Layout %s, width %s, indentation %s" layout width indent))
            (fanyi-test--with-result-buffer
              (let ((fanyi-youdao-thesaurus-layout layout)
                    (fanyi-youdao-thesaurus-indent indent)
                    (shr-width width) (inhibit-read-only t))
                (fanyi-youdao-thesaurus-render entries nil)
                (fanyi-test--fontify)
                (should (equal entries before))
                (should (<= (fanyi-shr-test--max-line-width) width))
                (should (equal (fanyi-test--button-data #'fanyi-dwim) '("word" "missing")))
                (let ((region (car fanyi-shr--regions)))
                  (should (equal
                           (replace-regexp-in-string
                            "[ \t\r\n]+" ""
                            (buffer-substring-no-properties
                             (fanyi-shr--region-start region) (fanyi-shr--region-end region)))
                           (concat "wordn." long-word "vt." chinese "missing暂无释义"))))
                (goto-char (point-min))
                (dolist (label '("n." "vt."))
                  (search-forward label)
                  (should (eq (get-char-property (match-beginning 0) 'face) 'fanyi-pos-face)))
                (search-forward "暂无释义")
                (should (eq (get-char-property (match-beginning 0) 'face) 'shadow))
                (if (and (eq layout 'columns) (= width 48))
                    (should (string-match-p "^word[ ]+n\\." (buffer-string)))
                  (should (string-match-p "^word\n[ ]+n\\." (buffer-string))))))))))))

(ert-deftest fanyi-youdao-ui-reflows-explanations-with-faces-and-selection ()
  (fanyi-test--with-result-buffer
    (save-window-excursion
      (set-window-buffer nil (current-buffer))
      (let ((fanyi-youdao-thesaurus-layout 'columns)
            (fanyi-youdao-thesaurus-indent 2)
            (shr-width 48) (inhibit-read-only t))
        (fanyi-youdao-thesaurus-render
         '(("word" . "n. antidisestablishmentarianismabcdefghijklmnopqrstuvwxyz；vt. 中文释义")
           ("missing" . "NO EXPLANATION")) nil)
        (goto-char (point-min))
        (search-forward "establishment")
        (set-mark (match-beginning 0))
        (let* ((region (car fanyi-shr--regions))
               (dom (fanyi-shr--region-dom region))
               (content (replace-regexp-in-string "[ \t\r\n]+" "" (buffer-string)))
               (transient-mark-mode t) (mark-active t) (deactivate-mark nil))
          (dolist (settings '((24 2 stacked) (24 30 stacked) (48 30 columns)
                              (2 30 stacked) (48 2 columns)))
            (pcase-let ((`(,shr-width ,fanyi-youdao-thesaurus-indent ,fanyi-youdao-thesaurus-layout)
                         settings))
              (fanyi-shr-reflow)
              (fanyi-test--fontify)
              (should (eq dom (fanyi-shr--region-dom region)))
              (should (use-region-p))
              (should (equal (replace-regexp-in-string
                              "[ \t\r\n]+" "" (buffer-substring-no-properties (mark) (point)))
                             "establishment"))
              (should (equal (replace-regexp-in-string "[ \t\r\n]+" "" (buffer-string)) content))
              (should (equal (fanyi-test--button-data #'fanyi-dwim) '("word" "missing")))
              (save-restriction
                (narrow-to-region (fanyi-shr--region-start region) (fanyi-shr--region-end region))
                (should (<= (fanyi-shr-test--max-line-width) shr-width))
                ;; Labels and the fallback may themselves wrap in two columns.
                (dolist (expected '((fanyi-pos-face . "n.vt.") (shadow . "暂无释义")))
                  (should
                   (equal (apply #'string
                                 (cl-loop for position from (point-min) below (point-max)
                                          when (and (eq (get-text-property position 'font-lock-face) (car expected))
                                                    (not (memq (char-after position) '(?\s ?\t ?\r ?\n))))
                                          collect (char-after position)))
                          (cdr expected))))))))))))

(provide 'fanyi-youdao-ui-tests)
