;;; fanyi-youdao-ui-tests.el --- Youdao entry layout and interaction -*- lexical-binding: t; -*-

(require 'fanyi-test-support)
(require 'fanyi-youdao-thesaurus)

(defconst fanyi-youdao-test--entries
  '(("sample" . "n. 样本；例子；vt. 取样；尝试")
    ("specimen" . "n. 标本；样本；供研究、观察和比较的实例，有时也指一个具有代表性的事物。")
    ("representative sample" . "NO EXPLANATION")))

(ert-deftest fanyi-youdao-ui-aligns-entries-and-wraps-explanations ()
  (fanyi-test--with-result-buffer
    (let ((shr-width 80)
          (fanyi-youdao-thesaurus-layout 'columns)
          (inhibit-read-only t)
          (before (copy-tree fanyi-youdao-test--entries)))
      (fanyi-youdao-thesaurus-render fanyi-youdao-test--entries nil)
      (should (equal before fanyi-youdao-test--entries))
      (should (string-match-p "^sample[ ]+n\\. 样本；例子\n[ ]+vt\\. 取样；尝试" (buffer-string)))
      (should (string-match-p "^representative sample[ ]+暂无释义" (buffer-string)))
      (goto-char (point-min))
      (search-forward "n. 样本")
      (let ((column (- (current-column) (string-width "n. 样本"))))
        (search-forward "vt. 取样")
        (should (= column (- (current-column) (string-width "vt. 取样"))))
        (search-forward "n. 标本")
        (should (= column (- (current-column) (string-width "n. 标本"))))
        (forward-line 1)
        (should (= (current-indentation) column)))
      (should (<= (fanyi-shr-test--max-line-width) 80))
      (should (equal (fanyi-test--button-data #'fanyi-dwim)
                     '("sample" "specimen" "representative sample"))))))

(ert-deftest fanyi-youdao-ui-keeps-semantic-faces-and-query-actions ()
  (fanyi-test--with-result-buffer
    (let ((inhibit-read-only t) queries)
      (fanyi-youdao-thesaurus-render fanyi-youdao-test--entries nil)
      (fanyi-test--fontify)
      (goto-char (point-min))
      (search-forward "sample")
      (let ((position (match-beginning 0)))
        (should (eq (get-text-property position 'font-lock-face) 'fanyi-youdao-thesaurus-word-face))
        (should (memq 'fanyi-youdao-thesaurus-word-face
                      (ensure-list (get-char-property position 'face))))
        (should (button-at position)))
      (search-forward "n. 样本")
      (should (eq (get-char-property (match-beginning 0) 'face) 'fanyi-pos-face))
      (search-forward "暂无释义")
      (should (eq (get-char-property (match-beginning 0) 'face) 'shadow))
      (cl-letf (((symbol-function 'fanyi-dwim) (lambda (word) (push word queries))))
        (goto-char (point-min))
        (search-forward "representative sample")
        (goto-char (match-beginning 0))
        (call-interactively (key-binding (kbd "RET"))))
      (should (equal queries '("representative sample"))))))

(ert-deftest fanyi-youdao-ui-reflows-without-fetching-and-preserves-reading-state ()
  (fanyi-test--with-result-buffer
    (save-window-excursion
      (set-window-buffer nil (current-buffer))
      (let ((inhibit-read-only t)
            (fanyi-youdao-thesaurus-layout 'columns)
            (shr-width 80))
        (insert "Earlier dictionary\n\n")
        (fanyi-youdao-thesaurus-render fanyi-youdao-test--entries nil)
        (insert "Later dictionary\n")
        (goto-char (point-min))
        (search-forward "样本；例子")
        (set-mark (match-beginning 0))
        (let* ((region (car fanyi-shr--regions))
               (dom (fanyi-shr--region-dom region))
               (selected (buffer-substring-no-properties (mark) (point)))
               (transient-mark-mode t) (mark-active t) (deactivate-mark nil))
          (cl-letf (((symbol-function 'url-retrieve) (lambda (&rest _) (ert-fail "No network"))))
            (dolist (width '(32 70 35))
              (let ((shr-width width))
                (fanyi-shr-reflow)
                (should (eq dom (fanyi-shr--region-dom region)))
                (should (use-region-p))
                (should (equal selected (buffer-substring-no-properties (mark) (point))))
                (should (string-prefix-p "Earlier dictionary\n\n" (buffer-string)))
                (should (string-suffix-p "Later dictionary\n" (buffer-string)))
                (should (<= (fanyi-shr-test--max-line-width) width))
                (should (equal (fanyi-test--button-data #'fanyi-dwim)
                               '("sample" "specimen" "representative sample")))
                (if (< width 54)
                    (should (string-match-p "^sample\n  n\\. 样本" (buffer-string)))
                  (should (string-match-p "^sample[ ]+n\\. 样本" (buffer-string)))))))
          (let ((fanyi-youdao-thesaurus-layout 'stacked)
                (fanyi-youdao-thesaurus-indent 4))
            (fanyi-shr--post-command)
            (should (string-match-p "^sample\n    n\\. 样本" (buffer-string)))))))))

(ert-deftest fanyi-youdao-ui-splits-only-explicit-part-of-speech-boundaries ()
  (fanyi-test--with-result-buffer
    (let ((inhibit-read-only t)
          (fanyi-youdao-thesaurus-layout 'stacked)
          (shr-width 80))
      (fanyi-youdao-thesaurus-render
       '(("word" . "\n  n. first; second；n.example；n._suffix；N. text；adj. next；(adv.) finally\n")) nil)
      (should (string-match-p "n\\. first; second；n\\.example；n\\._suffix；N\\. text\n  adj\\. next\n  (adv\\.) finally"
                              (buffer-string)))
      (fanyi-test--fontify)
      (goto-char (point-min))
      (dolist (text '("n.example" "n._suffix" "N."))
        (search-forward text)
        (should-not (get-char-property (match-beginning 0) 'font-lock-face))))))

(provide 'fanyi-youdao-ui-tests)
;;; fanyi-youdao-ui-tests.el ends here
