;;; fanyi-shr-reflow-tests.el --- HTML layout lifecycle tests -*- lexical-binding: t -*-

(require 'fanyi-test-support)
(require 'button)
(require 'outline)
(require 'fanyi-shr)

(ert-deftest fanyi-shr-reflow-preserves-narrowing-and-selection ()
  (fanyi-shr-test--with-window
    (insert "Earlier provider\n")
    (fanyi-shr-insert `(p nil ,fanyi-shr-test--text) nil)
    (insert "Later provider\n")
    (goto-char (point-min))
    (search-forward "word10")
    (let ((start (- (point) 3)))
      (search-forward "word30")
      (narrow-to-region start (- (point) 2)))
    (goto-char (point-min))
    (search-forward "word15")
    (set-mark (match-beginning 0))
    (search-forward "word25")
    (goto-char (match-beginning 0))
    (let ((text (fanyi-shr-test--text))
          (transient-mark-mode t)
          (mark-active t)
          (deactivate-mark nil))
      ;; The window can still start outside the restriction until redisplay.
      (dolist (shr-width '(30 55 20))
        (fanyi-shr-reflow)
        (should (buffer-narrowed-p))
        (should (equal text (fanyi-shr-test--text)))
        (should (looking-at-p "word25"))
        (should (use-region-p))
        (should (save-excursion (goto-char (mark)) (looking-at-p "word15"))))
      (widen)
      (should (string-prefix-p "Earlier provider\n" (buffer-string)))
      (should (string-suffix-p "Later provider\n" (buffer-string))))))

(ert-deftest fanyi-shr-narrowed-reflow-preserves-mark-outside-restriction ()
  (fanyi-shr-test--with-window
    (fanyi-shr-insert `(p nil ,fanyi-shr-test--text) nil)
    (goto-char (point-min))
    (search-forward "word05")
    (set-mark (match-beginning 0))
    (search-forward "word15")
    (narrow-to-region (match-beginning 0) (point-max))
    (let ((shr-width 25))
      (fanyi-shr-reflow)
      (should (< (mark t) (point-min)))
      (save-restriction
        (widen)
        (goto-char (mark t))
        (should (looking-at-p "word05"))))))

(ert-deftest fanyi-shr-narrowed-reflow-restores-restriction-after-interruption ()
  (dolist (failure '(error quit))
    (fanyi-shr-test--with-window
      (let (fail)
        (fanyi-shr-insert
         `(sample nil ,fanyi-shr-test--text)
         `((sample . ,(lambda (dom)
                        (shr-generic dom)
                        (when fail (signal failure '("Interrupted")))))))
        (goto-char (point-min))
        (search-forward "word10")
        (narrow-to-region (match-beginning 0) (point-max))
        (let ((text (buffer-string))
              (bounds (cons (point-min) (point-max))))
          (setq fail t)
          (should (eq failure (car (condition-case err (fanyi-shr-reflow t)
                                     ((error quit) err)))))
          (should (equal bounds (cons (point-min) (point-max))))
          (should (equal-including-properties text (buffer-string))))))))

(ert-deftest fanyi-shr-reflow-preserves-other-providers-and-reading-position ()
  (fanyi-shr-test--with-window
    (let ((prefix (propertize "# Earlier\n\nPreserve this.\n\n" 'face 'bold))
          (suffix (propertize "\n# Later\n\nKeep this too.\n" 'help-echo "later")))
      (insert prefix)
      (fanyi-shr-insert `(p nil ,fanyi-shr-test--text) nil)
      (insert suffix)
      (let ((old-lines (count-lines (point-min) (point-max))))
        (goto-char (point-min))
        (search-forward "word25")
        (goto-char (match-beginning 0))
        (let ((reading (buffer-substring-no-properties (point) (+ (point) 3)))
              (buffer-read-only t)
              (buffer-undo-list nil))
          (set-buffer-modified-p nil)
          (split-window-right 35)
          (fanyi-shr-reflow)
          (should (equal reading (buffer-substring-no-properties (point) (+ (point) 3))))
          (should buffer-read-only)
          (should-not buffer-undo-list)
          (should-not (buffer-modified-p))
          (should (> (count-lines (point-min) (point-max)) old-lines))
          (should (equal-including-properties
                   prefix (buffer-substring (point-min) (+ (point-min) (length prefix)))))
          (should (equal-including-properties
                   suffix (buffer-substring (- (point-max) (length suffix)) (point-max)))))))))

(ert-deftest fanyi-shr-uses-the-displaying-window-not-the-selected-window ()
  (fanyi-shr-test--with-window
    (let* ((buffer (current-buffer))
           (selected (selected-window))
           (target (split-window-right -25)))
      (set-window-buffer target buffer)
      (set-window-buffer selected (get-buffer-create " *fanyi-shr-other-window*"))
      (unwind-protect
          (progn
            (fanyi-shr-insert `(p nil ,fanyi-shr-test--text) nil)
            (should (eq selected (selected-window)))
            (should (< (fanyi-shr-test--max-line-width) (window-body-width target)))
            (should (equal (fanyi-shr-test--text) fanyi-shr-test--text)))
        (kill-buffer " *fanyi-shr-other-window*")))))

(ert-deftest fanyi-shr-reflow-preserves-active-selections-in-both-directions ()
  (dolist (ends '(("word10" "word25") ("word25" "word10")))
    (fanyi-shr-test--with-window
      (fanyi-shr-insert `(p nil ,fanyi-shr-test--text) nil)
      (goto-char (point-min))
      (search-forward (car ends))
      (set-mark (match-beginning 0))
      (goto-char (point-min))
      (search-forward (cadr ends))
      (goto-char (match-beginning 0))
      (let ((transient-mark-mode t)
            (mark-active t)
            (deactivate-mark nil)
            (ring mark-ring)
            (selected (replace-regexp-in-string
                       "[ \t\r\n]+" " "
                       (buffer-substring-no-properties (region-beginning) (region-end)))))
        (split-window-right 35)
        (fanyi-shr-reflow)
        (should (use-region-p))
        (should-not deactivate-mark)
        (should (eq mark-ring ring))
        (should (looking-at-p (cadr ends)))
        (should (save-excursion (goto-char (mark)) (looking-at-p (car ends))))
        (should (equal selected
                       (replace-regexp-in-string
                        "[ \t\r\n]+" " "
                        (buffer-substring-no-properties (region-beginning) (region-end)))))))))

(ert-deftest fanyi-shr-reflow-preserves-an-inactive-mark ()
  (fanyi-shr-test--with-window
    (fanyi-shr-insert `(p nil ,fanyi-shr-test--text) nil)
    (goto-char (point-min))
    (search-forward "word10")
    (set-mark (match-beginning 0))
    (let ((mark-active nil)
          (deactivate-mark t)
          (shr-width 35))
      (fanyi-shr-reflow)
      (should-not mark-active)
      (should deactivate-mark)
