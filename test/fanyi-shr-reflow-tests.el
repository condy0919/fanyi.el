(ert-deftest fanyi-shr-reflow-does-not-create-an-unset-mark ()
  (fanyi-shr-test--with-window
    (fanyi-shr-insert `(p nil ,fanyi-shr-test--text) nil)
    (should-not (mark t))
    (let ((mark-active nil)
          (deactivate-mark nil)
