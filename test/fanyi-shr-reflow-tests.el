(ert-deftest fanyi-shr-rendering-preserves-horizontal-scroll ()
  (fanyi-shr-test--with-window
    (set-window-hscroll nil 7)
    (fanyi-shr-insert `(p nil ,fanyi-shr-test--text) nil)
    (should (= (window-hscroll) 7))
    (should (equal (fanyi-shr-test--text) fanyi-shr-test--text))
    (let ((shr-width 35))
      (fanyi-shr-reflow)
      (should (= (window-hscroll) 7))
      (should (<= (fanyi-shr-test--max-line-width) shr-width))
      (should (equal (fanyi-shr-test--text) fanyi-shr-test--text)))))

(ert-deftest fanyi-shr-reflows-only-when-layout-changes ()
  (fanyi-shr-test--with-window
    (let ((renders 0)
          (renderer (lambda (dom) (shr-generic dom))))
      (cl-letf (((symbol-function 'fanyi-shr-test--count-render)
                 (lambda (dom) (cl-incf renders) (funcall renderer dom))))
        (fanyi-shr-insert `(sample nil ,fanyi-shr-test--text)
                          '((sample . fanyi-shr-test--count-render)))
        (should (= renders 1))
        (fanyi-shr--window-change (selected-window))
        (should (= renders 1))
        (split-window-right 35)
        ;; Batch Emacs does not run redisplay hooks, so invoke the registered
        ;; hook with the real resized window rather than mocking its width.
        (run-hook-with-args 'window-size-change-functions (selected-window))
        (should (= renders 2))
        (fanyi-shr--window-change (selected-window))
        (should (= renders 2))
        (let ((second (next-window)))
          (set-window-buffer second (current-buffer))
          (select-window second)
          (run-hook-with-args 'window-selection-change-functions second)
          (should (= renders 3)))))))

(ert-deftest fanyi-shr-reflow-retains-actions-without-network ()
  (fanyi-shr-test--with-window
    (let (clicked)
      (cl-letf (((symbol-function 'url-retrieve)
                 (lambda (&rest _) (ert-fail "Reflow must not fetch resources")))
                ((symbol-function 'url-retrieve-synchronously)
                 (lambda (&rest _) (ert-fail "Reflow must not fetch resources")))
                ((symbol-function 'url-queue-retrieve)
                 (lambda (&rest _) (ert-fail "Reflow must not fetch resources"))))
        (fanyi-shr-insert
         `(div nil (p nil ,fanyi-shr-test--text)
               (a ((href . "https://example.invalid/query")))
               (img ((src . "https://example.invalid/image.png"))))
         `((a . ,(lambda (dom)
                   (insert-button "Query" 'button-data (dom-attr dom 'href)
                                  'action (lambda (url) (setq clicked url)))))))
        (split-window-right 35)
        (fanyi-shr-reflow)
        (should-not clicked)
        (goto-char (point-min))
        (search-forward "Query")
        (let ((button (button-at (match-beginning 0))))
          (should button)
          (button-activate button))
        (should (equal clicked "https://example.invalid/query"))))))

(ert-deftest fanyi-shr-defers-fontification-until-html-is-complete ()
  (fanyi-shr-test--with-window
    (let* ((calls 0)
           (fontification-functions
            (list (lambda (_position)
                    (cl-incf calls)
                    (with-silent-modifications
                      (remove-text-properties (point-min) (point-max) '(face nil)))))))
      (fanyi-shr-insert
       '(sample nil "Styled content")
       `((sample . ,(lambda (dom)
                      (let ((start (point)))
                        (shr-generic dom)
                        (add-face-text-property start (point) 'bold)
                        ;; GUI pixel measurement may request fontification at
                        ;; this stage, before the region is marked as HTML.
                        (run-hook-with-args 'fontification-functions start))))))
      (should (= calls 0))
      (should (get-text-property (point-min) 'fanyi-html))
      (should (eq (get-text-property (point-min) 'font-lock-face) 'bold))
      ;; The caller's fontification callbacks resume after insertion.
      (run-hook-with-args 'fontification-functions (point-min))
      (should (= calls 1))
      (should (eq (get-text-property (point-min) 'font-lock-face) 'bold)))))

(ert-deftest fanyi-shr-clears-saved-dom-on-erase-and-mode-change ()
  (fanyi-shr-test--with-window
    (dolist (clear '(erase-buffer fundamental-mode))
      (fanyi-shr-insert '(p nil "Saved content") nil)
      (let ((region (car fanyi-shr--regions)))
        (funcall clear)
        (should-not fanyi-shr--regions)
        (should-not (marker-buffer (fanyi-shr--region-start region)))
        (should-not (marker-buffer (fanyi-shr--region-end region)))
        (should-not (memq #'fanyi-shr--window-change window-size-change-functions))))))

(ert-deftest fanyi-shr-clears-saved-dom-on-kill ()
  (let ((buffer (generate-new-buffer " *fanyi-shr-kill*")) region)
    (unwind-protect
        (progn
          (with-current-buffer buffer
            (fanyi-shr-insert '(p nil "Saved content") nil)
            (setq region (car fanyi-shr--regions)))
          (kill-buffer buffer)
          (should-not (marker-buffer (fanyi-shr--region-start region)))
          (should-not (marker-buffer (fanyi-shr--region-end region))))
      (when (buffer-live-p buffer) (kill-buffer buffer)))))

(ert-deftest fanyi-shr-reflow-keeps-old-content-on-render-error ()
  (fanyi-shr-test--with-window
    (let (fail)
      (fanyi-shr-insert
       `(div nil (p nil ,fanyi-shr-test--text) (sample nil "Last sentence."))
       `((sample . ,(lambda (dom)
                      (if fail (error "Rendering failed") (shr-generic dom))))))
      (let ((before (buffer-string))
            (start (marker-position (fanyi-shr--region-start (car fanyi-shr--regions))))
            (end (marker-position (fanyi-shr--region-end (car fanyi-shr--regions)))))
        (setq fail t)
        (set-window-hscroll nil 7)
        (should-error (fanyi-shr-reflow t))
        (should (= (window-hscroll) 7))
        (should (equal-including-properties before (buffer-string)))
        (should (= start (fanyi-shr--region-start (car fanyi-shr--regions))))
        (should (= end (fanyi-shr--region-end (car fanyi-shr--regions))))))))

(ert-deftest fanyi-shr-reflow-retries-errors-after-style-change-or-force ()
  (let ((fanyi-shr--buffers nil) (post-command-hook nil))
    (fanyi-shr-test--with-window
      (let ((style 'original) (renders 0) (errors 0) fail)
        (fanyi-shr-insert
         '(sample nil "Keep this result")
         `((sample . ,(lambda (dom)
                        (cl-incf renders)
                        (shr-generic dom)
                        (when fail (error "Persistent renderer failure")))))
         (lambda (_window) style))
        (let ((before (buffer-string)))
          (cl-letf (((symbol-function 'message) (lambda (&rest _) (cl-incf errors))))
            (setq style 'changed fail t)
            (dotimes (_ 5) (run-hooks 'post-command-hook))
            (should (= renders 2))
            (should (= errors 1))
            (should (equal-including-properties before (buffer-string)))
            ;; A visit to the successful style permits another attempt when
            ;; returning, even though that visit requires no rendering.
            (setq style 'original)
            (run-hooks 'post-command-hook)
            (should (= renders 2))
            (setq style 'changed)
            (dotimes (_ 3) (run-hooks 'post-command-hook))
            (should (= renders 3))
            (should (= errors 2))
            (setq style 'another-style)
            (dotimes (_ 3) (run-hooks 'post-command-hook))
            (should (= renders 4))
            (should (= errors 3))
            ;; C-u explicitly retries the unchanged failing style and keeps
            ;; reporting its error to the caller.
            (let ((current-prefix-arg '(4)))
              (should-error (call-interactively #'fanyi-shr-reflow)))
            (should (= renders 5))
            (should (equal-including-properties before (buffer-string)))
            (run-hooks 'post-command-hook)
            (should (= renders 5))
            (setq fail nil)
            (let ((current-prefix-arg '(4)))
              (call-interactively #'fanyi-shr-reflow))
            (should (= renders 6))
            (run-hooks 'post-command-hook)
            (should (= renders 6))
            (setq style 'original)
            (run-hooks 'post-command-hook)
            (should (= renders 7))))))))

(ert-deftest fanyi-shr-reflow-retries-errors-after-width-change ()
  (let ((fanyi-shr--buffers nil) (post-command-hook nil))
    (fanyi-shr-test--with-window
      (let ((renders 0) fail)
        (fanyi-shr-insert
         `(sample nil ,fanyi-shr-test--text)
         `((sample . ,(lambda (dom)
                        (cl-incf renders)
                        (if fail (error "Persistent renderer failure")
                          (shr-generic dom))))))
        (setq fail t)
        (split-window-right 35)
        (dotimes (_ 3) (run-hooks 'post-command-hook))
        (should (= renders 2))
        (delete-other-windows)
        (run-hooks 'post-command-hook)
        (should (= renders 2))
        (split-window-right 35)
        (dotimes (_ 3) (run-hooks 'post-command-hook))
        (should (= renders 3))
        (setq fail nil)
        (let ((shr-width 20))
          (dotimes (_ 3) (run-hooks 'post-command-hook))
          (should (= renders 4))
          (should (<= (fanyi-shr-test--max-line-width) 20)))))))

(ert-deftest fanyi-shr-reflow-retries-interrupted-layout ()
  (let ((fanyi-shr--buffers nil) (post-command-hook nil))
    (fanyi-shr-test--with-window
      (let ((style 0) (renders 0) interrupted)
        (fanyi-shr-insert
         '(sample nil "Interrupted result")
         `((sample . ,(lambda (dom)
                        (cl-incf renders)
                        (shr-generic dom)
                        (when interrupted (signal 'quit nil)))))
         (lambda (_window) style))
        (setq style 1 interrupted t)
        (should (eq 'quit (condition-case nil (run-hooks 'post-command-hook)
                            (quit 'quit))))
        (should (= renders 2))
        (setq interrupted nil)
        (run-hooks 'post-command-hook)
        (should (= renders 3))
        (run-hooks 'post-command-hook)
        (should (= renders 3))))))

(ert-deftest fanyi-shr-reflow-failed-region-does-not-block-later-checks ()
  (let ((fanyi-shr--buffers nil) (post-command-hook nil))
    (fanyi-shr-test--with-window
      (let ((style 0) (good-renders 0) (bad-renders 0) fail)
        (fanyi-shr-insert
         '(sample nil "Working result")
         `((sample . ,(lambda (dom) (cl-incf good-renders) (shr-generic dom))))
         (lambda (_window) style))
        (insert "\n")
        ;; Newly inserted regions are checked first.  Once its failed layout
        ;; is skipped, the other region must still update automatically.
        (fanyi-shr-insert
         '(sample nil "Keep this result")
         `((sample . ,(lambda (dom)
                        (cl-incf bad-renders)
                        (if fail (error "Persistent renderer failure")
                          (shr-generic dom)))))
         (lambda (_window) style))
        (setq style 1 fail t)
        (dotimes (_ 5) (run-hooks 'post-command-hook))
        (should (= bad-renders 2))
        (should (= good-renders 2))
        (should (equal (fanyi-shr-test--text) "Working result Keep this result"))))))

(ert-deftest fanyi-shr-reflow-preserves-collapsed-outline-subtrees ()
  (fanyi-shr-test--with-window
    (setq-local outline-regexp "^#+")
    (outline-minor-mode 1)
    (fanyi-shr-insert
     `(div nil (p nil "## Hidden section") (p nil ,fanyi-shr-test--text)
           (p nil "## Visible section") (p nil "Visible conclusion."))
     nil)
    (goto-char (point-min))
    (outline-hide-subtree)
    (let* ((body (save-excursion (search-forward "word25") (match-beginning 0)))
           (fold (cl-find-if (lambda (overlay)
                               (eq (overlay-get overlay 'invisible) 'outline))
                             (overlays-at body))))
      (should fold)
      (should (outline-invisible-p body))
      (split-window-right 35)
      (fanyi-shr-reflow)
      (should (eq (overlay-buffer fold) (current-buffer)))
      (should-not (outline-invisible-p (point-min)))
      (goto-char (point-min))
      (search-forward "word25")
      (should (outline-invisible-p (match-beginning 0)))
      (search-forward "## Visible section")
      (should-not (outline-invisible-p (match-beginning 0)))
      (search-forward "Visible conclusion.")
      (should-not (outline-invisible-p (match-beginning 0))))))

(ert-deftest fanyi-shr-style-refresh-is-selective-and-cleans-up ()
  (let ((fanyi-shr--buffers nil)
        (post-command-hook nil))
    (fanyi-shr-test--with-window
      (let ((style (list 'original))
            (first-renders 0) (second-renders 0))
        (fanyi-shr-insert
         '(sample nil "First result")
         `((sample . ,(lambda (dom) (cl-incf first-renders) (shr-generic dom))))
         (lambda (_window) style))
        (insert "\n")
        (fanyi-shr-insert
         '(sample nil "Second result")
         `((sample . ,(lambda (dom) (cl-incf second-renders) (shr-generic dom))))
         (lambda (_window) 'unchanged))
        (should (memq (current-buffer) fanyi-shr--buffers))
        (should (memq #'fanyi-shr--post-command post-command-hook))
        (run-hooks 'post-command-hook)
        (should (equal (list first-renders second-renders) '(1 1)))
        ;; Mutating the same list must not mutate its saved signature.
        (setcar style 'changed)
        (with-temp-buffer (run-hooks 'post-command-hook))
        (should (equal (list first-renders second-renders) '(2 1)))
        (run-hooks 'post-command-hook)
        (should (equal (list first-renders second-renders) '(2 1)))
        (fundamental-mode)
        (should-not fanyi-shr--buffers)
        (should-not (memq #'fanyi-shr--post-command post-command-hook))))))

(ert-deftest fanyi-shr-style-refresh-isolates-buffer-errors ()
  (let ((fanyi-shr--buffers nil)
        (post-command-hook nil)
        (bad (generate-new-buffer " *fanyi-shr-style-error*")))
    (unwind-protect
        (fanyi-shr-test--with-window
          (let ((good (current-buffer)) (state 0) (renders 0) fail)
            (fanyi-shr-insert
             '(sample nil "Working result")
             `((sample . ,(lambda (dom) (cl-incf renders) (shr-generic dom))))
             (lambda (_window) state))
            (let ((other (split-window-right 35)))
              (set-window-buffer other bad)
              (with-current-buffer bad
                (fanyi-shr-insert
                 '(p nil "Keep this result") nil
                 (lambda (_window) (if fail (error "Invalid style") state))))
              ;; The bad buffer is checked first; its error must not block good.
              (setq state 1 fail t)
              (run-hooks 'post-command-hook)
              (should (= renders 2))
              (should (memq #'fanyi-shr--post-command post-command-hook))
              (with-current-buffer bad
                (should (string-match-p "Keep this result" (buffer-string))))
              ;; Hidden buffers wait until they are displayed again.
              (set-window-buffer other good)
              (setq state 2)
              (with-current-buffer bad
                (cl-letf (((symbol-function 'message)
                           (lambda (&rest _) (ert-fail "Hidden buffers must not refresh"))))
                  (run-hooks 'post-command-hook)))
              (should (= renders 3))
              (kill-buffer bad)
              (should (equal fanyi-shr--buffers (list good)))
              (erase-buffer)
              (should-not fanyi-shr--buffers)
              (should-not (memq #'fanyi-shr--post-command post-command-hook)))))
      (when (buffer-live-p bad) (kill-buffer bad)))))

