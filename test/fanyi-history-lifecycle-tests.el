;;; fanyi-history-lifecycle-tests.el --- Cached history lifecycle -*- lexical-binding: t; -*-

(require 'fanyi-test-support)
(require 'fanyi-longman)

(ert-deftest fanyi-history-resumes-only-pending-and-keeps-restored-retry-live ()
  (fanyi-test--with-query
    (let ((success (fanyi-test--provider "https://success.invalid/%s"))
          (missing (fanyi-test--provider "https://missing.invalid/%s"))
          (failure (fanyi-test--provider "https://failure.invalid/%s"))
          (pending (fanyi-test--provider "https://pending.invalid/%s")))
      (setf (fanyi-provider-parse missing) (lambda (&rest _) (throw 'not-found nil)))
      (setq fanyi-providers (list success missing failure pending))
      (fanyi-dwim "Dragon")
      (fanyi-test--respond (nth 0 fanyi-test--requests) nil "cached success")
      (fanyi-test--respond (nth 1 fanyi-test--requests))
      (fanyi-test--respond (nth 2 fanyi-test--requests) '(:error (error http 503)))
      (let ((obsolete (nth 3 fanyi-test--requests))
            (old-failure (cl-find-if #'fanyi--task-failure
                                     (fanyi-test--query-state 'fanyi--tasks))))
        (setq fanyi-providers (list success))
        (fanyi-dwim "Sun")
        (fanyi-test--respond (nth 4 fanyi-test--requests) nil "sun definition")
        (with-current-buffer fanyi-buffer-name
          ;; History uses the captured requests even with every provider disabled.
          (let ((fanyi-providers nil)) (fanyi-back))
          (should (equal fanyi-current-word "Dragon"))
          (should (= (length fanyi-test--requests) 6))
          (should (= (length fanyi--tasks) 4))
          (should (= fanyi--tasks-completed 2))
          (should (= fanyi--tasks-failed 1))
          (should (= (cl-count-if-not #'fanyi--task-done fanyi--tasks) 1))
          (should (string-match-p "cached success" (buffer-string)))
          (should (string-match-p "No results found" (buffer-string)))
          (let ((retries (fanyi-test--button-data #'fanyi--retry-task)))
            (should (= (length retries) 1))
            (should-not (eq (car retries) old-failure))
            (should (memq (car retries) fanyi--tasks))
            ;; A response from before navigation cannot replace the restored page.
            (fanyi-test--respond obsolete nil "obsolete pending definition")
            (should-not (string-match-p "obsolete" (buffer-string)))
            (should (= fanyi--tasks-completed 2))
            (fanyi-test--respond (nth 5 fanyi-test--requests) nil "resumed pending")
            (should (= fanyi--tasks-completed 3))
            (should (= fanyi--tasks-failed 1))
            (fanyi--retry-task (car retries))
            (should (= (length fanyi-test--requests) 7))
            (should (= fanyi--tasks-failed 0))
            (fanyi-test--respond (nth 6 fanyi-test--requests) nil "recovered failure")
            (should (= fanyi--tasks-completed 4))
            (should (= fanyi--tasks-failed 0))
            (should-not (fanyi-test--button-data #'fanyi--retry-task)))
          ;; Revisiting the other completed page needs no additional request.
          (fanyi-forward)
          (should (equal fanyi-current-word "Sun"))
          (should (string-match-p "sun definition" (buffer-string)))
          (should (= (length fanyi-test--requests) 7))
          (fanyi-back)
          (should (= (length fanyi-test--requests) 7))
          (should (= fanyi--tasks-completed 4))
          (should (string-match-p "recovered failure" (buffer-string))))))))

(ert-deftest fanyi-history-synchronous-resume-keeps-selection-on-cached-dictionary ()
  (dolist (reverse-selection '(nil t))
    (ert-info ((format "Reverse selection: %S" reverse-selection))
      (fanyi-test--with-query
        (let ((earlier (fanyi-test--provider "https://earlier.invalid/%s"))
              (later (fanyi-test--provider "https://later.invalid/%s"))
              (transient-mark-mode t))
          (setq fanyi-providers (list earlier later))
          (fanyi-dwim "alpha")
          (fanyi-test--respond (nth 1 fanyi-test--requests) nil "kept definition")
          (with-current-buffer fanyi-buffer-name
            (save-window-excursion
              (set-window-buffer nil (current-buffer))
              (goto-char (point-min))
              (search-forward "alpha: kept")
              (set-mark (match-beginning 0))
              (when reverse-selection (exchange-point-and-mark))
              (setq mark-active t deactivate-mark nil)
              (set-window-start nil (point-min) t)
              (let ((selected (buffer-substring-no-properties
                               (region-beginning) (region-end))))
                (setq fanyi-providers (list later))
                (fanyi-dwim "beta")
                (fanyi-test--respond (nth 2 fanyi-test--requests) nil "other page")
                ;; The resumed earlier dictionary can complete inside url-retrieve.
                (cl-letf (((symbol-function 'url-retrieve)
                           (lambda (&rest arguments)
                             (let ((buffer (apply #'fanyi-test--retrieve arguments)))
                               (fanyi-test--respond (car (last fanyi-test--requests))
                                                    nil "resumed before")
                               buffer))))
                  (fanyi-back))
                (should (= (length fanyi-test--requests) 4))
                (should (= fanyi--tasks-completed 2))
                (should (= fanyi--tasks-failed 0))
                (should (equal (buffer-string)
                               "alpha: resumed before\nalpha: kept definition\n"))
                (should (use-region-p))
                (should (equal selected (buffer-substring-no-properties
                                         (region-beginning) (region-end))))
                (should (eq (< (point) (mark)) reverse-selection))
                (should (save-excursion
                          (goto-char (window-start))
                          (looking-at-p "alpha: kept definition")))
                (should-not (cl-some #'fanyi--task-timer fanyi--tasks))))))))))

(ert-deftest fanyi-history-resumes-a-retry-without-counting-its-old-failure-twice ()
  (fanyi-test--with-query
    (fanyi-dwim "alpha")
    (fanyi-test--respond (car fanyi-test--requests) '(:error (error http 503)))
    (with-current-buffer fanyi-buffer-name
      (fanyi--retry-task (car fanyi--tasks)))
    (let ((obsolete (nth 1 fanyi-test--requests)))
      (fanyi-dwim "beta")
      (fanyi-test--respond (nth 2 fanyi-test--requests) nil "other page")
      (with-current-buffer fanyi-buffer-name
        (fanyi-back)
        (should (= (length fanyi-test--requests) 4))
        (should (= fanyi--tasks-completed 0))
        (should (= fanyi--tasks-failed 0))
        (should-not (fanyi--task-done (car fanyi--tasks)))
        (should (string-match-p "Retrying dictionary" (buffer-string)))
        (fanyi-test--respond obsolete nil "obsolete retry")
        (should-not (string-match-p "obsolete" (buffer-string)))
        (fanyi-test--respond (nth 3 fanyi-test--requests) nil "restored retry")
        (should (= fanyi--tasks-completed 1))
        (should (= fanyi--tasks-failed 0))
        (should (equal (buffer-string) "alpha: restored retry\n"))))))

(ert-deftest fanyi-history-longman-restores-folds-selection-and-narrowing-at-new-width ()
  (fanyi-test--with-query
    (let ((fanyi-use-glyphs nil)
          (fanyi-providers (list fanyi-longman-provider))
          (transient-mark-mode t)
          (shr-width 68))
      (fanyi-dwim "explode")
      (fanyi-test--deliver
       (car fanyi-test--requests) nil
       (with-temp-buffer
         (insert-file-contents (expand-file-name "longman-explode-saved.html"
                                                 fanyi-test--fixture-directory))
         (buffer-string)))
      (with-current-buffer fanyi-buffer-name
        (save-window-excursion
          (set-window-buffer nil (current-buffer))
          (button-activate (fanyi-test--longman-style-button "THESAURUS"))
          (goto-char (point-min))
          (search-forward "## Examples from the Corpus")
          (beginning-of-line)
          (outline-hide-subtree)
          (goto-char (point-min))
          (search-forward "Register")
          (narrow-to-region (match-beginning 0) (point-max))
          (search-forward "In everyday English")
          (set-mark (match-beginning 0))
          (setq mark-active t deactivate-mark nil)
          (set-window-start nil (point-min) t)
          (let ((before (buffer-substring-no-properties (point-min) (point-max)))
                (selected (buffer-substring-no-properties (mark) (point))))
            (setq fanyi-providers (list (fanyi-test--provider)))
            (fanyi-dwim "other")
            (fanyi-test--respond (nth 1 fanyi-test--requests) nil "another page")
            (let ((shr-width 38)) (fanyi-back))
            (should (= (length fanyi-test--requests) 2))
            (should (equal fanyi-current-word "explode"))
            (should (buffer-narrowed-p))
            (should (use-region-p))
            (should (equal selected (buffer-substring-no-properties (mark) (point))))
            (should (save-excursion (goto-char (point-min)) (looking-at-p "Register")))
            (should (save-excursion (goto-char (window-start)) (looking-at-p "Register")))
            ;; Wrapping adapts to the current width without discarding text.
            (should-not (equal before (buffer-substring-no-properties
                                       (point-min) (point-max))))
            (should (equal (replace-regexp-in-string "[ \t\r\n]+" "" before)
                           (replace-regexp-in-string "[ \t\r\n]+" "" (buffer-string))))
            (save-excursion
              (goto-char (point-min))
              (search-forward "If you roll a misfire")
              (should (outline-invisible-p (match-beginning 0)))
              (goto-char (point-min))
              (search-forward "TO EXPLODE")
              (should (invisible-p (match-beginning 0)))
              (let* ((button (fanyi-test--longman-style-button "THESAURUS"))
                     (section (button-get button 'fanyi-shr-section)))
                (should (fanyi-shr--section-closed section))
                (button-activate button)
                (should-not (fanyi-shr--section-closed section))))))))))

(ert-deftest fanyi-history-render-failure-does-not-transfer-fold-state-to-next-dictionary ()
  (fanyi-test--with-query
    (let ((first (copy-fanyi-provider fanyi-longman-provider))
          (fanyi-use-glyphs nil)
          (transient-mark-mode t)
          (html (with-temp-buffer
                  (insert-file-contents
                   (expand-file-name "longman-explode-saved.html" fanyi-test--fixture-directory))
                  (buffer-string)))
          fail-first selected)
      (setf (fanyi-provider-render first)
            (lambda (result request)
              (if fail-first
                  (error "The first cached dictionary cannot render")
                (fanyi-longman-render result request))))
      (setq fanyi-providers (list first fanyi-longman-provider))
      (fanyi-dwim "explode")
      (fanyi-test--deliver (nth 0 fanyi-test--requests) nil html)
      (fanyi-test--deliver (nth 1 fanyi-test--requests) nil html)
      (with-current-buffer fanyi-buffer-name
        (let ((sections (cl-mapcan #'fanyi--reader-sections (reverse fanyi--tasks))))
          (should (= (length sections) 2))
          (fanyi-shr--section-set-closed (nth 0 sections) t)
          (fanyi-shr--section-set-closed (nth 1 sections) nil))
        ;; The reader is in the second result, after the section that will fail.
        (goto-char (fanyi--task-start (car fanyi--tasks)))
        (search-forward "In everyday English")
        (set-mark (match-beginning 0))
        (setq mark-active t deactivate-mark nil
              selected (buffer-substring-no-properties (mark) (point))))
      (setq fanyi-providers (list (fanyi-test--provider)))
      (fanyi-dwim "other")
      (fanyi-test--respond (nth 2 fanyi-test--requests) nil "other page")
      (setq fail-first t)
      (with-current-buffer fanyi-buffer-name
        (fanyi-back)
        (should (= (length fanyi-test--requests) 3))
        (should (= fanyi--tasks-completed 1))
        (should (= fanyi--tasks-failed 1))
        (should (string-match-p "cannot render" (buffer-string)))
        (should (use-region-p))
        (should (equal selected (buffer-substring-no-properties (mark) (point))))
        (let ((sections (cl-mapcan #'fanyi--reader-sections (reverse fanyi--tasks))))
          (should (= (length sections) 1))
          (should-not (fanyi-shr--section-closed (car sections))))))))

(ert-deftest fanyi-history-quit-during-cached-render-cleans-tasks-and-keeps-original-quit ()
  (fanyi-test--with-query
    (let ((pending (fanyi-test--provider "https://pending.invalid/%s"))
          (quitter (fanyi-test--provider "https://quitter.invalid/%s"))
          (later (fanyi-test--provider "https://later.invalid/%s"))
          cancel)
      (setf (fanyi-provider-render quitter)
            (lambda (result request)
              (if cancel
                  (progn (insert "PARTIAL RESTORED TEXT")
                         (signal 'quit '(history-render-interrupted)))
                (fanyi-test--render result request))))
      (setq fanyi-providers (list pending quitter later))
      (fanyi-dwim "alpha")
      (fanyi-test--respond (nth 1 fanyi-test--requests) nil "cached before quit")
      (fanyi-test--respond (nth 2 fanyi-test--requests) nil "cached later")
      (setq fanyi-providers (list later))
      (fanyi-dwim "beta")
      (fanyi-test--respond (nth 3 fanyi-test--requests) nil "other page")
      (setq cancel t)
      (with-current-buffer fanyi-buffer-name
        (should (equal (condition-case condition (fanyi-back)
                         (quit condition))
                       '(quit history-render-interrupted)))
        ;; Cached rendering precedes new downloads, and its partial text is atomic.
        (should (= (length fanyi-test--requests) 4))
        (should-not (string-match-p "PARTIAL" (buffer-string)))
        (should (cl-every #'fanyi--task-done fanyi--tasks))
        (should-not (cl-some #'fanyi--task-timer fanyi--tasks))
        (should-not (cl-some #'buffer-live-p fanyi-test--buffers))
        (setq cancel nil)
        (fanyi-dwim "after quit")
        (fanyi-test--respond (nth 4 fanyi-test--requests) nil "normal result")
        (should (= fanyi--tasks-completed 1))
        (should (= fanyi--tasks-failed 0))
        (should (equal (buffer-string) "after quit: normal result\n"))))))

(provide 'fanyi-history-lifecycle-tests)
