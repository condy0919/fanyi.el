;;; fanyi-navigation-tests.el --- Visible button navigation -*- lexical-binding: t; -*-

(require 'ert)
(require 'fanyi)
(require 'fanyi-shr)
(require 'fanyi-test-support)
(require 'fanyi-longman)
(require 'fanyi-haici)

(defun fanyi-navigation-test--press (key)
  "Run the command bound to KEY and return the label at point."
  (call-interactively (key-binding (kbd key)))
  (button-label (button-at (point))))

(ert-deftest fanyi-navigation-skips-folded-section-buttons-and-restores-them ()
  (with-temp-buffer
    (fanyi-mode)
    (let ((inhibit-read-only t))
      (insert-button "Before" 'action #'ignore)
      (insert "\n")
      (fanyi-shr-insert
       '(section nil (span nil "Details") (p nil (a nil "Hidden query")))
       '((section . (lambda (dom) (fanyi-shr-insert-section dom (nth 2 dom) (nth 3 dom))))
         (a . (lambda (dom)
                (let ((start (point)))
                  (shr-generic dom)
                  (make-text-button start (point) 'keymap button-map 'action #'ignore))))))
      (insert "\n")
      (insert-button "After" 'action #'ignore))
    (goto-char (point-min))
    (should (equal (fanyi-navigation-test--press "<tab>") "Details"))
    (button-activate (button-at (point)))
    (should (equal (fanyi-navigation-test--press "TAB") "After"))
    (should (equal (fanyi-navigation-test--press "<backtab>") "Details"))
    (button-activate (button-at (point)))
    (should (equal (fanyi-navigation-test--press "<tab>") "Hidden query"))
    (should-not (invisible-p (point)))
    (should (equal (fanyi-navigation-test--press "<backtab>") "Details"))))

(ert-deftest fanyi-navigation-skips-outline-folds-and-keeps-heading-bindings ()
  (with-temp-buffer
    (fanyi-mode)
    (let ((inhibit-read-only t))
      (insert-button "Before" 'action #'ignore)
      (insert "\n## Corpus\n")
      (insert-button "Hidden corpus link" 'action #'ignore)
      (insert "\n## Next\n")
      (insert-button "After" 'action #'ignore))
    (goto-char (point-min))
    (search-forward "## Corpus")
    (beginning-of-line)
    (outline-hide-subtree)
    (goto-char (point-min))
    (should (equal (fanyi-navigation-test--press "TAB") "After"))
    (should (equal (fanyi-navigation-test--press "<backtab>") "Before"))
    (should (eq (lookup-key fanyi-mode-cycle-map (kbd "TAB")) #'outline-cycle))
    (should (eq (lookup-key fanyi-mode-cycle-map [tab]) #'outline-cycle))))

(ert-deftest fanyi-navigation-wraps-counts-and-handles-no-visible-buttons ()
  (with-temp-buffer
    (fanyi-mode)
    (let ((inhibit-read-only t))
      (insert-button "First" 'action #'ignore)
      (insert " ")
      (insert-button "Skipped" 'skip t 'action #'ignore)
      (insert " ")
      (insert-button "Last" 'action #'ignore))
    (goto-char (point-min))
    (fanyi-forward-button 3)
    (should (equal (button-label (button-at (point))) "Last"))
    (fanyi-forward-button -3)
    (should (equal (button-label (button-at (point))) "First"))
    (let ((overlay (make-overlay (point-min) (point-max)))
          (before (point)))
      (overlay-put overlay 'invisible t)
      (should-error (fanyi-forward-button 1) :type 'user-error)
      (should-error (fanyi-backward-button 1) :type 'user-error)
      (should (= before (point))))))

(ert-deftest fanyi-navigation-headings-and-unified-folding-respect-visible-content ()
  (fanyi-test--with-result-buffer
    (let ((inhibit-read-only t))
      (insert "# One\nIntroduction\n## Definitions\n")
      (fanyi-shr-insert
       '(section nil (span nil "Details")
                 (div nil (p nil "Detailed content.")
                      (section nil (span nil "Nested") (p nil "Nested content."))))
       '((section . (lambda (dom) (fanyi-shr-insert-section dom (nth 2 dom) (nth 3 dom))))))
      (insert "## Examples\nExample content.\n# Two\nMore content.\n"))
    (fanyi-test--fontify)
    (goto-char (point-min))
    (dolist (label '("## Definitions" "Details" "Nested" "## Examples" "# Two"))
      (call-interactively (key-binding "n"))
      (should (looking-at-p (regexp-quote label))))
    (let ((before (point)))
      (should-error (fanyi-next-heading 1) :type 'user-error)
      (should (= (point) before))
      (should-error (fanyi-previous-heading 20) :type 'user-error)
      (should (= (point) before)))
    (fanyi-previous-heading 3)
    (should (looking-at-p "Details"))
    (call-interactively (key-binding (kbd "C-c <tab>")))
    (let ((section (button-get (button-at (point)) 'fanyi-shr-section)))
      (should (fanyi-shr--section-closed section)))
    (call-interactively (key-binding "n"))
    (should (looking-at-p "## Examples"))
    (call-interactively (key-binding "p"))
    (should (looking-at-p "Details"))
    (call-interactively (key-binding (kbd "C-c TAB")))
    (call-interactively (key-binding (kbd "TAB")))
    (should (looking-at-p "Nested"))
    (fanyi-previous-heading 2)
    (should (looking-at-p "## Definitions"))
    (call-interactively (key-binding (kbd "C-c TAB")))
    (should (outline-invisible-p (line-end-position)))
    (call-interactively (key-binding "n"))
    (should (looking-at-p "## Examples"))
    (fanyi-previous-heading 1)
    (call-interactively (key-binding (kbd "C-c TAB")))
    ;; This explicit navigation key works even on outline's TAB keymap.
    (call-interactively (key-binding (kbd "C-c C-n")))
    (should (looking-at-p "Details"))
    (call-interactively (key-binding (kbd "C-c C-n")))
    (should (looking-at-p "Nested"))
    (call-interactively (key-binding (kbd "C-c C-p")))
    (should (looking-at-p "Details"))
    (let ((start (point))
          (end (save-excursion (search-forward "## Examples") (match-beginning 0))))
      (narrow-to-region start end)
      (fanyi-next-heading 1)
      (should (looking-at-p "Nested"))
      (should-error (fanyi-next-heading 1) :type 'user-error)
      (fanyi-previous-heading 1)
      (should (looking-at-p "Details"))
      (should-error (fanyi-previous-heading 1) :type 'user-error))))

(ert-deftest fanyi-navigation-pronunciation-prefers-current-dictionary-and-dialect ()
  (fanyi-test--with-result-buffer
    (let ((inhibit-read-only t) (fanyi-use-glyphs nil))
      (dolist (source `((,fanyi-longman-provider . "longman.html")
                        (,fanyi-haici-provider . "haici.html")))
        (let ((request (fanyi-make-request (car source) "sample")))
          (fanyi-render-result request (fanyi-parse-response request (fanyi-test--read-fixture (cdr source))))))
      (insert "# Empty dictionary\nNo audio.\n"))
    (let (played)
      (cl-letf (((symbol-function 'fanyi-play-sound) (lambda (url) (push url played))))
        (dolist (case '(("# Longman" "https://example.invalid/sample-uk.mp3" "https://example.invalid/sample-us.mp3")
                        ("# 海词" "https://audio.dict.cn/sample-uk-f" "https://audio.dict.cn/sample-us-f")
                        ("# Empty dictionary" "https://example.invalid/sample-uk.mp3" "https://example.invalid/sample-us.mp3")))
          (goto-char (point-min))
          (search-forward (car case))
          (let ((before (point)))
            (call-interactively (key-binding "v"))
            (should (equal (car played) (nth 1 case)))
            (call-interactively (key-binding "V"))
            (should (equal (car played) (nth 2 case)))
            (should (= (point) before))))
        ;; The full dictionary remains available while reading a narrow view.
        (goto-char (point-min))
        (search-forward "# 海词")
        (narrow-to-region (line-beginning-position) (line-end-position))
        (let ((start (point-min)) (end (point-max)) (before (point)))
          (fanyi-pronounce)
          (should (equal (car played) "https://audio.dict.cn/sample-uk-f"))
          (should (= (point) before))
          (should (= (point-min) start))
          (should (= (point-max) end)))))))

(ert-deftest fanyi-navigation-pronunciation-skips-examples-and-supports-one-dialect ()
  (let ((dom (fanyi-test--read-fixture "longman.html")) played)
    (dom-remove-node dom (car (dom-by-class dom "brefile")))
    (fanyi-test--with-rendered-response fanyi-longman-provider dom
      (cl-letf (((symbol-function 'fanyi-play-sound) (lambda (url) (push url played))))
        (goto-char (point-max))
        (fanyi-pronounce)
        (should (equal played '("https://example.invalid/sample-us.mp3"))))))
  (let ((dom (fanyi-test--read-fixture "longman.html")))
    (dom-remove-node dom (car (dom-by-class dom "brefile")))
    (dom-remove-node dom (car (dom-by-class dom "amefile")))
    (fanyi-test--with-rendered-response fanyi-longman-provider dom
      (should (fanyi-test--button-data #'fanyi-play-sound))
      (should-error (fanyi-pronounce) :type 'user-error))))

(ert-deftest fanyi-navigation-refresh-reuses-renamed-result-buffer ()
  (fanyi-test--with-query
    (fanyi-dwim "sample")
    (fanyi-test--respond (car fanyi-test--requests))
    (with-current-buffer fanyi--active-buffer
      (rename-buffer (generate-new-buffer-name " *fanyi-renamed-navigation*"))
      (let ((buffer (current-buffer))
            (original fanyi-buffer-name)
            (first-query fanyi--buffer-query-id))
        (call-interactively (key-binding "g"))
        (should (eq fanyi--active-buffer buffer))
        (should-not (get-buffer original))
        (should (equal fanyi-current-word "sample"))
        (should (> fanyi--buffer-query-id first-query))
        (should (= (length fanyi-test--requests) 2))
        (fanyi-test--respond (cadr fanyi-test--requests) nil "fresh definition")
        (should (string-match-p "fresh definition" (buffer-string))))))
  (with-temp-buffer
    (fanyi-mode)
    (should-error (revert-buffer nil t) :type 'user-error)))

(provide 'fanyi-navigation-tests)
