;;; fanyi-navigation-tests.el --- Visible button navigation -*- lexical-binding: t; -*-

(require 'ert)
(require 'fanyi)
(require 'fanyi-shr)

(defun fanyi-navigation-test--press (key)
  "Run the command bound to KEY and return the label at point."
  (call-interactively (key-binding (kbd key)))
  (button-label (button-at (point))))

(ert-deftest fanyi-navigation-skips-folded-section-buttons-and-restores-them ()
  (with-temp-buffer
    (fanyi-mode)
    (let ((inhibit-read-only t))
      (insert-button "Before" 'action #'ignore)
      (insert "\n")
      (fanyi-shr-insert
       '(section nil (span nil "Details") (p nil (a nil "Hidden query")))
       '((section . (lambda (dom) (fanyi-shr-insert-section dom (nth 2 dom) (nth 3 dom))))
         (a . (lambda (dom)
                (let ((start (point)))
                  (shr-generic dom)
                  (make-text-button start (point) 'keymap button-map 'action #'ignore))))))
      (insert "\n")
      (insert-button "After" 'action #'ignore))
    (goto-char (point-min))
    (should (equal (fanyi-navigation-test--press "<tab>") "Details"))
    (button-activate (button-at (point)))
    (should (equal (fanyi-navigation-test--press "TAB") "After"))
    (should (equal (fanyi-navigation-test--press "<backtab>") "Details"))
    (button-activate (button-at (point)))
    (should (equal (fanyi-navigation-test--press "<tab>") "Hidden query"))
    (should-not (invisible-p (point)))
    (should (equal (fanyi-navigation-test--press "<backtab>") "Details"))))

(ert-deftest fanyi-navigation-skips-outline-folds-and-keeps-heading-bindings ()
  (with-temp-buffer
    (fanyi-mode)
    (let ((inhibit-read-only t))
      (insert-button "Before" 'action #'ignore)
      (insert "\n## Corpus\n")
      (insert-button "Hidden corpus link" 'action #'ignore)
      (insert "\n## Next\n")
      (insert-button "After" 'action #'ignore))
    (goto-char (point-min))
    (search-forward "## Corpus")
    (beginning-of-line)
    (outline-hide-subtree)
    (goto-char (point-min))
    (should (equal (fanyi-navigation-test--press "TAB") "After"))
    (should (equal (fanyi-navigation-test--press "<backtab>") "Before"))
    (should (eq (lookup-key fanyi-mode-cycle-map (kbd "TAB")) #'outline-cycle))
    (should (eq (lookup-key fanyi-mode-cycle-map [tab]) #'outline-cycle))))

(ert-deftest fanyi-navigation-wraps-counts-and-handles-no-visible-buttons ()
  (with-temp-buffer
    (fanyi-mode)
    (let ((inhibit-read-only t))
      (insert-button "First" 'action #'ignore)
      (insert " ")
      (insert-button "Skipped" 'skip t 'action #'ignore)
      (insert " ")
      (insert-button "Last" 'action #'ignore))
    (goto-char (point-min))
    (fanyi-forward-button 3)
    (should (equal (button-label (button-at (point))) "Last"))
    (fanyi-forward-button -3)
    (should (equal (button-label (button-at (point))) "First"))
    (let ((overlay (make-overlay (point-min) (point-max)))
          (before (point)))
      (overlay-put overlay 'invisible t)
      (should-error (fanyi-forward-button 1) :type 'user-error)
      (should-error (fanyi-backward-button 1) :type 'user-error)
      (should (= before (point))))))

(provide 'fanyi-navigation-tests)
;;; fanyi-navigation-tests.el ends here
