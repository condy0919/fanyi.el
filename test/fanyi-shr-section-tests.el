;;; fanyi-shr-section-tests.el --- Local HTML section tests -*- lexical-binding: t -*-

(require 'fanyi-test-support)
(require 'outline)
(require 'fanyi-shr)

(defun fanyi-shr-section-test--render (dom)
  "Render the title and body of test section DOM."
  (fanyi-shr-insert-section dom (nth 2 dom) (nth 3 dom)))

(defconst fanyi-shr-section-test--renderers
  '((section . fanyi-shr-section-test--render)))

(defun fanyi-shr-section-test--position (text)
  "Return the beginning of TEXT in the current buffer."
  (save-excursion
    (goto-char (point-min))
    (search-forward text)
    (match-beginning 0)))

(defun fanyi-shr-section-test--button (text)
  "Return the section button containing TEXT."
  (button-at (fanyi-shr-section-test--position text)))

(defun fanyi-shr-section-test--overlay (text)
  "Return the section body overlay at TEXT."
  (cl-find-if (lambda (overlay) (overlay-get overlay 'fanyi-shr-section))
              (overlays-at (fanyi-shr-section-test--position text))))

(ert-deftest fanyi-shr-sections-toggle-only-their-own-body ()
  (fanyi-shr-test--with-window
    (insert "# Earlier provider\n\n")
    (let ((shr-width 25))
      (fanyi-shr-insert
       '(div nil
             (section nil (span nil "First title with a continued heading")
                      (p nil "First body."))
             (p nil "Next definition.")
             (section nil (span nil "Second title") (p nil "Second body.")))
       fanyi-shr-section-test--renderers))
    (insert "\n# Later provider\n\nLast body.")
    (let* ((title (fanyi-shr-section-test--button "First title"))
           (text (buffer-substring-no-properties (point-min) (point-max)))
           (position (point))
           (buffer-read-only t)
           (buffer-undo-list nil))
      (set-buffer-modified-p nil)
      (should title)
      (should (= (button-start title)
                 (button-start (fanyi-shr-section-test--button "heading"))))
      (should (= (button-end title)
                 (button-end (fanyi-shr-section-test--button "heading"))))
      (should (equal "▾ F" (get-text-property (button-start title) 'display)))
      (button-activate title)
      (should (invisible-p (fanyi-shr-section-test--position "First body")))
      (dolist (visible '("Earlier provider" "Next definition" "Second title" "Second body" "Later provider"))
        (should-not (invisible-p (fanyi-shr-section-test--position visible))))
      (should (= position (point)))
      (should buffer-read-only)
      (should-not buffer-undo-list)
      (should-not (buffer-modified-p))
      (should (equal text (buffer-substring-no-properties (point-min) (point-max))))
      (should (equal "▸ F" (get-text-property (button-start title) 'display)))
      (goto-char (button-start title))
      (call-interactively (key-binding (kbd "RET")))
      (should-not (invisible-p (fanyi-shr-section-test--position "First body"))))))

(ert-deftest fanyi-shr-sections-and-outline-fold-independently ()
  (fanyi-shr-test--with-window
    (setq-local outline-regexp "^#+")
    (outline-minor-mode 1)
    (fanyi-shr-insert
     '(div nil (p nil "## Parent heading")
           (section nil (span nil "Local title") (p nil "Local body."))
           (p nil "Following definition.") (p nil "## Next heading") (p nil "Next body."))
     fanyi-shr-section-test--renderers)
    (button-activate (fanyi-shr-section-test--button "Local title"))
    (goto-char (point-min))
    (outline-hide-subtree)
    (should (outline-invisible-p (fanyi-shr-section-test--position "Local title")))
    (fanyi-shr-reflow t)
    (should (outline-invisible-p (fanyi-shr-section-test--position "Following definition")))
    (outline-show-subtree)
    (should-not (invisible-p (fanyi-shr-section-test--position "Local title")))
    (should (invisible-p (fanyi-shr-section-test--position "Local body")))
    (should-not (invisible-p (fanyi-shr-section-test--position "Following definition")))
    (button-activate (fanyi-shr-section-test--button "Local title"))
    (should-not (invisible-p (fanyi-shr-section-test--position "Local body")))))

(ert-deftest fanyi-shr-sections-keep-state-styling-and-actions-on-reflow ()
  (fanyi-shr-test--with-window
    (let (clicked)
      (cl-letf (((symbol-function 'url-retrieve)
                 (lambda (&rest _) (ert-fail "Reflow must not request content"))))
        (fanyi-shr-insert
         `(div nil
               (section nil (strong nil "Closed title")
                        (div nil (p nil ,fanyi-shr-test--text) (query nil "Query")))
               (section nil (strong nil "Open title") (p nil "Visible body.")))
         (cons `(query . ,(lambda (dom)
                            (let ((start (point)))
                              (shr-generic dom)
                              (make-text-button start (point) 'action
                                                (lambda (_) (setq clicked t))))))
               fanyi-shr-section-test--renderers))
        (button-activate (fanyi-shr-section-test--button "Closed title"))
        (goto-char (fanyi-shr-section-test--position "Visible body"))
        (let ((old-overlay (fanyi-shr-section-test--overlay "word01")))
          (split-window-right 30)
          (fanyi-shr-reflow)
          (should (looking-at "Visible body"))
          (should-not (overlay-buffer old-overlay)))
        (should (invisible-p (fanyi-shr-section-test--position "word25")))
        (should-not (invisible-p (fanyi-shr-section-test--position "Visible body")))
        ;; Simulate font-lock's clearing of display faces, as a major mode's
        ;; refresh does.  The semantic face and title actions remain intact.
        (font-lock-unfontify-region (point-min) (point-max))
        (let ((title (fanyi-shr-section-test--button "Closed title")))
          (should (get-text-property (button-start title) 'font-lock-face))
          (button-activate title))
        (should-not (invisible-p (fanyi-shr-section-test--position "word25")))
        (button-activate (fanyi-shr-section-test--button "Query"))
        (should clicked)))))

(ert-deftest fanyi-shr-sections-isearch-opens-and-remembers-the-section ()
  (fanyi-shr-test--with-window
    (fanyi-shr-insert '(section nil (span nil "Title") (p nil "Search target."))
                      fanyi-shr-section-test--renderers)
    (button-activate (fanyi-shr-section-test--button "Title"))
    (let ((overlay (fanyi-shr-section-test--overlay "Search target")))
      (funcall (overlay-get overlay 'isearch-open-invisible) overlay))
    (should-not (invisible-p (fanyi-shr-section-test--position "Search target")))
    (should (equal "▾ T" (get-text-property (fanyi-shr-section-test--position "Title") 'display)))
    (fanyi-shr-reflow t)
    (should-not (invisible-p (fanyi-shr-section-test--position "Search target")))))

(ert-deftest fanyi-shr-sections-release-overlays-markers-and-stale-actions ()
  (dolist (clear '(erase-buffer fundamental-mode kill-buffer))
    (fanyi-shr-test--with-window
      (setq-local buffer-invisibility-spec '(outline))
      (fanyi-shr-insert '(section nil (span nil "Title") (p nil "Body."))
                        fanyi-shr-section-test--renderers)
      (let* ((button (fanyi-shr-section-test--button "Title"))
             (section (button-get button 'fanyi-shr-section))
             (overlay (fanyi-shr-section-test--overlay "Body")))
        (button-activate button)
        (funcall clear)
        (should-not (overlay-buffer overlay))
        (dolist (marker (list (fanyi-shr--section-heading-start section)
                              (fanyi-shr--section-heading-end section)
                              (fanyi-shr--section-body-start section)
                              (fanyi-shr--section-body-end section)))
          (should-not (marker-buffer marker)))
        (when (eq clear 'fundamental-mode)
          (should-not (fanyi-shr-section-test--button "Title"))
          (should-not (get-text-property (point-min) 'display))
          (should-not (invisible-p (fanyi-shr-section-test--position "Body")))
          (fanyi-shr-toggle-section))))))

(ert-deftest fanyi-shr-sections-roll-back-render-failures ()
  (fanyi-shr-test--with-window
    (let* ((fail nil)
           (dom '(div nil (section nil (span nil "Title") (p nil "Body."))
                      (failure nil "Conclusion.")))
           (renderers (cons `(failure . ,(lambda (node)
                                           (if fail (error "Rendering failed") (shr-generic node))))
                            fanyi-shr-section-test--renderers)))
      (fanyi-shr-insert dom renderers)
      (button-activate (fanyi-shr-section-test--button "Title"))
      (let ((before (buffer-string))
            (overlay (fanyi-shr-section-test--overlay "Body")))
        (setq fail t)
        (should-error (fanyi-shr-reflow t))
        (should (equal-including-properties before (buffer-string)))
        (should (eq overlay (fanyi-shr-section-test--overlay "Body")))
        (should (invisible-p (fanyi-shr-section-test--position "Body")))
        (button-activate (fanyi-shr-section-test--button "Title"))
        (should-not (invisible-p (fanyi-shr-section-test--position "Body"))))
      (erase-buffer)
      (insert "Original content.")
      (should-error (fanyi-shr-insert dom renderers))
      (should (equal "Original content." (buffer-string)))
      (should-not fanyi-shr--regions)
      (should-not (overlays-in (point-min) (point-max))))))

(ert-deftest fanyi-shr-sections-without-a-cache-render-expanded-content ()
  (with-temp-buffer
    (let ((shr-external-rendering-functions fanyi-shr-section-test--renderers))
      (shr-insert-document '(section nil (span nil "Title") (p nil "Body."))))
    (should (equal "Title Body." (fanyi-shr-test--text)))
    (should-not (fanyi-shr-section-test--button "Title"))
    (should-not (overlays-in (point-min) (point-max)))
    (should-not fanyi-shr--regions)))

(ert-deftest fanyi-shr-sections-roll-back-cancelled-reflows ()
  (dolist (stage '(render installed))
    (fanyi-shr-test--with-window
      (setq-local outline-regexp "^#+")
      (outline-minor-mode 1)
      (let ((cancel nil)
            (set-closed (symbol-function 'fanyi-shr--section-set-closed))
            replacements)
        (cl-letf (((symbol-function 'fanyi-shr--section-set-closed)
                   (lambda (section closed)
                     (funcall set-closed section closed)
                     (when cancel
                       (cl-pushnew section replacements)
                       (when (and closed (eq stage 'installed))
                         (signal 'quit '(cancelled-reflow)))))))
          (insert "Earlier provider.\n\n")
          (fanyi-shr-insert
           '(div nil (p nil "## Main heading")
                 (section nil (span nil "Title") (p nil "Body words."))
                 (probe nil "Following definition.")
                 (p nil "## Next heading") (p nil "Selection begins. Conclusion."))
           (cons `(probe . ,(lambda (dom)
                              (if (and cancel (eq stage 'render))
                                  (progn
                                    (setq replacements (copy-sequence fanyi-shr--sections))
                                    (signal 'quit '(cancelled-reflow)))
                                (shr-generic dom))))
                 fanyi-shr-section-test--renderers))
          (insert "\nLater provider.")
          (button-activate (fanyi-shr-section-test--button "Title"))
          (goto-char (fanyi-shr-section-test--position "## Main heading"))
          (outline-hide-subtree)
          (set-mark (fanyi-shr-section-test--position "Selection begins"))
          (goto-char (fanyi-shr-section-test--position "Conclusion"))
          (let* ((region (car fanyi-shr--regions))
                 (section (car (fanyi-shr--region-sections region)))
                 (markers (mapcar
                           (lambda (marker) (cons marker (marker-position marker)))
                           (list (fanyi-shr--region-start region) (fanyi-shr--region-end region)
                                 (fanyi-shr--section-heading-start section)
                                 (fanyi-shr--section-heading-end section)
                                 (fanyi-shr--section-body-start section)
                                 (fanyi-shr--section-body-end section))))
                 (overlays (overlays-in (point-min) (point-max)))
                 (before (buffer-string))
                 (layout (fanyi-shr--region-layout region))
                 (mark-active t)
                 (deactivate-mark nil)
                 (shr-width 25))
            (setq cancel t)
            (should (equal (condition-case result (fanyi-shr-reflow)
                             ((error quit) result))
                           '(quit cancelled-reflow)))
            (should (equal-including-properties before (buffer-string)))
            (should (equal layout (fanyi-shr--region-layout region)))
            (dolist (state markers) (should (= (car state) (cdr state))))
            (should-not (cl-set-exclusive-or overlays (overlays-in (point-min) (point-max))))
            (should (outline-invisible-p (fanyi-shr-section-test--position "Title")))
            (should (fanyi-shr--section-closed section))
            (should (looking-at-p "Conclusion"))
            (should (save-excursion (goto-char (mark)) (looking-at-p "Selection begins")))
            (should mark-active)
            (should-not deactivate-mark)
            (dolist (replacement replacements)
              (when (fanyi-shr--section-overlay replacement)
                (should-not (overlay-buffer (fanyi-shr--section-overlay replacement))))
              (dolist (marker (list (fanyi-shr--section-heading-start replacement)
                                    (fanyi-shr--section-heading-end replacement)
                                    (fanyi-shr--section-body-start replacement)
                                    (fanyi-shr--section-body-end replacement)))
                (should-not (marker-buffer marker))))
            ;; Cancellation must leave a usable cache and title action.
            (setq cancel nil)
            (fanyi-shr-reflow)
            (goto-char (fanyi-shr-section-test--position "## Main heading"))
            (outline-show-subtree)
            (should (invisible-p (fanyi-shr-section-test--position "Body words")))
            (button-activate (fanyi-shr-section-test--button "Title"))
            (should-not (invisible-p (fanyi-shr-section-test--position "Body words")))))))))

(ert-deftest fanyi-shr-sections-cleanup-errors-do-not-replace-quit ()
  (fanyi-shr-test--with-window
    (fanyi-shr-insert '(section nil (span nil "Title") (p nil "Body."))
                      fanyi-shr-section-test--renderers)
    (button-activate (fanyi-shr-section-test--button "Title"))
    (let ((set-closed (symbol-function 'fanyi-shr--section-set-closed))
          (forget (symbol-function 'fanyi-shr--section-forget))
          (old (car (fanyi-shr--region-sections (car fanyi-shr--regions)))))
      (cl-letf (((symbol-function 'fanyi-shr--section-set-closed)
                 (lambda (section closed)
                   (funcall set-closed section closed)
                   (when closed (signal 'quit '(original-cancellation)))))
                ((symbol-function 'fanyi-shr--section-forget)
                 (lambda (section)
                   (funcall forget section)
                   (unless (eq section old) (error "Cleanup failed")))))
        (should (equal (condition-case result (fanyi-shr-reflow t)
                         ((error quit) result))
                       '(quit original-cancellation))))
      (should (eq (fanyi-shr--section-overlay old) (fanyi-shr-section-test--overlay "Body")))
      (should (invisible-p (fanyi-shr-section-test--position "Body"))))))

(provide 'fanyi-shr-section-tests)
