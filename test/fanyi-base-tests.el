;;; fanyi-base-tests.el --- Audio and diagnostic tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'fanyi-base)

(defmacro fanyi-test--with-audio (&rest body)
  "Evaluate BODY with a mocked download and player."
  (declare (indent 0) (debug t))
  `(let ((fanyi-sound-player "test-player")
         (fanyi-sound-player-support-https nil)
         (fanyi-log nil)
         (fanyi-verbose nil)
         (buffer (generate-new-buffer " *fanyi-test-audio*"))
         callback played sent eof)
     (unwind-protect
         (cl-letf (((symbol-function 'url-retrieve)
                    (lambda (_url fn &rest _args)
                      (setq callback fn)
                      buffer))
                   ((symbol-function 'make-process)
                    (lambda (&rest _args) (setq played t) 'test-player))
                   ((symbol-function 'process-send-region)
                    (lambda (_proc start end)
                      (setq sent (buffer-substring-no-properties start end))))
                   ((symbol-function 'process-live-p) (lambda (_proc) t))
                   ((symbol-function 'process-send-eof)
                    (lambda (_proc) (setq eof t))))
           (with-current-buffer buffer
             (insert "\naudio bytes")
             (setq-local url-http-end-of-headers 1))
           ,@body)
       (when (buffer-live-p buffer)
         (kill-buffer buffer)))))

(ert-deftest fanyi-audio-accepts-empty-status-and-cleans-response ()
  (fanyi-test--with-audio
    (fanyi-play-sound "https://example.invalid/audio")
    (with-current-buffer buffer
      (funcall callback nil))
    (should played)
    (should (equal sent "audio bytes"))
    (should eof)
    (should-not (buffer-live-p buffer))))

(ert-deftest fanyi-audio-pipe-preserves-every-byte-regardless-of-text-coding ()
  (skip-unless (executable-find "cat"))
  (dolist (coding '(utf-8-dos utf-16le))
    (let ((fanyi-sound-player (executable-find "cat"))
          (fanyi-sound-player-support-https nil)
          (coding-system-for-write coding)
          (bytes (apply #'unibyte-string (number-sequence 0 255)))
          (make-process (symbol-function 'make-process))
          (response (generate-new-buffer " *fanyi-binary-response*"))
          process reports)
      (unwind-protect
          (with-temp-buffer
            (set-buffer-multibyte nil)
            (let ((output (current-buffer)))
              (with-current-buffer response
                (set-buffer-multibyte nil)
                (insert "\n" bytes)
                (setq-local url-http-end-of-headers 1))
              (cl-letf (((symbol-function 'url-retrieve)
                         (lambda (_url callback &rest _)
                           (with-current-buffer response (funcall callback nil))
                           response))
                        ((symbol-function 'make-process)
                         (lambda (&rest args)
                           (setq process (apply make-process (plist-put args :buffer output)))))
                        ((symbol-function 'fanyi--report-sound-error)
                         (lambda (err) (push err reports))))
                (fanyi-play-sound "https://example.invalid/audio")
                (let ((deadline (+ (float-time) 2)))
                  (while (and (process-live-p process) (< (float-time) deadline))
                    (accept-process-output process 0.05)))
                (should (eq (process-status process) 'exit))
                (should (= (process-exit-status process) 0))
                (should-not reports)
                (should-not (buffer-live-p response))
                (should (equal bytes (buffer-string))))))
        (when (and process (process-live-p process)) (delete-process process))
        (when (buffer-live-p response) (kill-buffer response))))))

(ert-deftest fanyi-audio-captures-player-and-options-before-download ()
  (fanyi-test--with-audio
    (let ((chosen-player (copy-sequence "chosen-player"))
          (options (list (copy-sequence "--stream")))
          command)
      (cl-letf (((symbol-function 'fanyi--sound-player-options)
                 (lambda (_player) options))
                ((symbol-function 'make-process)
                 (lambda (&rest args)
                   (setq command (plist-get args :command))
                   (should (plist-get args :noquery))
                   'test-player)))
        (let ((fanyi-sound-player chosen-player))
          (fanyi-play-sound "https://example.invalid/audio"))
        ;; Later configuration changes cannot affect an in-flight download.
        (aset chosen-player 0 ?X)
        (aset (car options) 0 ?X)
        (with-current-buffer buffer (funcall callback nil))
        (should (equal command '("chosen-player" "-" "--stream")))
        (should-not (buffer-live-p buffer))))))

(ert-deftest fanyi-audio-player-exit-reports-only-failure-once ()
  (let ((shell (executable-find "sh")))
    (skip-unless shell)
    (dolist (status '(0 7))
      (let ((fanyi-sound-player shell)
            (fanyi-sound-player-support-https t)
            process reports)
        (unwind-protect
            (cl-letf (((symbol-function 'fanyi--sound-player-options)
                       (lambda (_player) (list (format "exit %d" status))))
                      ((symbol-function 'fanyi--report-sound-error)
                       (lambda (err) (push (error-message-string err) reports))))
              ;; Run a real local child process without fetching audio.
              (setq process (fanyi-play-sound "-c"))
              (should (processp process))
              (should-not (process-query-on-exit-flag process))
              (let ((deadline (+ (float-time) 2)))
                (while (and (process-live-p process) (< (float-time) deadline))
                  (accept-process-output process 0.05)))
              (should (eq (process-status process) 'exit))
              (should (= (process-exit-status process) status))
              (if (zerop status)
                  (should-not reports)
                (should (= (length reports) 1))
                (should (string-match-p "code 7" (car reports)))
                ;; A second terminal notification must not duplicate the error.
                (funcall (process-sentinel process) process "exited abnormally with code 7\n")
                (should (= (length reports) 1))))
          (when (and process (process-live-p process))
            (set-process-sentinel process #'ignore)
            (delete-process process)))))))

(ert-deftest fanyi-audio-synchronous-download-cleans-response ()
  (fanyi-test--with-audio
    (cl-letf (((symbol-function 'url-retrieve)
               (lambda (_url fn &rest _args)
                 (with-current-buffer buffer (funcall fn nil))
                 buffer)))
      (fanyi-play-sound "https://example.invalid/audio"))
    (should played)
    (should (equal sent "audio bytes"))
    (should eof)
    (should-not (buffer-live-p buffer))))

(ert-deftest fanyi-audio-error-does-not-play-response ()
  (fanyi-test--with-audio
    (fanyi-play-sound "https://example.invalid/audio")
    (with-current-buffer buffer
      (funcall callback '(:error (error http 404))))
    (should-not played)
    (should-not sent)
    (should-not (buffer-live-p buffer))))

(ert-deftest fanyi-audio-player-error-cleans-response ()
  (fanyi-test--with-audio
    (fanyi-play-sound "https://example.invalid/audio")
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest _args) (error "Player unavailable"))))
      (with-current-buffer buffer
        (funcall callback nil)))
    (should-not sent)
    (should-not (buffer-live-p buffer))))

(ert-deftest fanyi-audio-interrupted-transfer-cleans-player-and-response ()
  ;; Both writing audio and closing stdin can fail or be interrupted.
  (dolist (operation '(send eof))
    (dolist (failure '(error quit))
      (let ((fanyi-sound-player "test-player")
            (fanyi-sound-player-support-https nil)
            (fanyi-log nil)
            (fanyi-verbose nil)
            (buffer (generate-new-buffer " *fanyi-test-audio*"))
            callback player reports)
        (unwind-protect
            (cl-letf (((symbol-function 'url-retrieve)
                       (lambda (_url fn &rest _args)
                         (setq callback fn)
                         buffer))
                      ((symbol-function 'make-process)
                       (lambda (&rest args)
                         (setq player (make-pipe-process
                                       :name "fanyi-test-player"
                                       :buffer nil :noquery t
                                       :sentinel (plist-get args :sentinel)))))
                      ((symbol-function 'fanyi--report-sound-error)
                       (lambda (err) (push err reports)))
                      ((symbol-function 'process-send-region)
                       (lambda (&rest _args)
                         (when (eq operation 'send)
                           (signal failure nil))))
                      ((symbol-function 'process-send-eof)
                       (lambda (&rest _args)
                         (when (eq operation 'eof)
                           (signal failure nil)))))
              (with-current-buffer buffer
                (insert "\naudio bytes")
                (setq-local url-http-end-of-headers 1))
              (fanyi-play-sound "https://example.invalid/audio")
              (condition-case nil
                  (with-current-buffer buffer
                    (funcall callback nil))
                (quit nil))
              (should (processp player))
              (should-not (process-live-p player))
              (should (eq (process-sentinel player) #'ignore))
              (should (= (length reports) (if (eq failure 'error) 1 0)))
              (should-not (buffer-live-p buffer)))
          (when (and player (process-live-p player))
            (delete-process player))
          (when (buffer-live-p buffer)
            (kill-buffer buffer)))))))

(ert-deftest fanyi-audio-start-error-is-reported ()
  (let ((fanyi-sound-player "test-player")
        (fanyi-sound-player-support-https nil)
        (fanyi-log nil)
        (fanyi-verbose t)
        report)
    (cl-letf (((symbol-function 'url-retrieve)
               (lambda (&rest _args) (error "Cannot connect")))
              ((symbol-function 'message)
               (lambda (fmt &rest args)
                 (setq report (apply #'format fmt args)))))
      (fanyi-play-sound "https://example.invalid/audio"))
    (should (string-match-p "Cannot connect" report))))

(ert-deftest fanyi-audio-cleans-redirect-chain ()
  (fanyi-test--with-audio
    (let ((redirected (generate-new-buffer " *fanyi-test-audio-redirect*")))
      (unwind-protect
          (progn
            (fanyi-play-sound "https://example.invalid/audio")
            (with-current-buffer buffer
              (setq-local url-redirect-buffer redirected))
            (with-current-buffer redirected
              (insert "\nredirected audio")
              (setq-local url-http-end-of-headers 1)
              (funcall callback '(:redirect "https://example.invalid/new")))
            (should (equal sent "redirected audio"))
            (should-not (buffer-live-p buffer))
            (should-not (buffer-live-p redirected)))
        (when (buffer-live-p redirected)
          (kill-buffer redirected))))))

(ert-deftest fanyi-log-formats-multiple-arguments ()
  (let ((fanyi-log t)
        (fanyi-log-buffer-name (generate-new-buffer-name " *fanyi-test-log*")))
    (unwind-protect
        (progn
          (fanyi-log "%s: %d" "failure" 500)
          (with-current-buffer fanyi-log-buffer-name
            (should (string-match-p "failure: 500\n" (buffer-string)))))
      (when (get-buffer fanyi-log-buffer-name)
        (kill-buffer fanyi-log-buffer-name)))))

(ert-deftest fanyi-user-error-formats-message-and-log ()
  (let ((fanyi-log t)
        (fanyi-verbose t)
        (fanyi-log-buffer-name (generate-new-buffer-name " *fanyi-test-log*")))
    (unwind-protect
        (let ((err (should-error (fanyi-user-error "%s: %d" "failure" 500)
                                 :type 'user-error)))
          (should (equal (error-message-string err) "failure: 500"))
          (with-current-buffer fanyi-log-buffer-name
            (should (string-match-p "failure: 500\n" (buffer-string)))))
      (when (get-buffer fanyi-log-buffer-name)
        (kill-buffer fanyi-log-buffer-name)))))

(ert-deftest fanyi-log-appends-in-read-only-narrowed-buffer-without-moving-reader ()
  (let ((fanyi-log t)
        (fanyi-log-buffer-name (generate-new-buffer-name " *fanyi-test-log*")))
    (unwind-protect
        (progn
          (fanyi-log "first")
          (fanyi-log "second")
          (with-current-buffer fanyi-log-buffer-name
            (special-mode)
            (goto-char (point-min))
            (narrow-to-region (point-min) (line-end-position))
            (let ((position (point)) (end (point-max)))
              (fanyi-log "third")
              (should buffer-read-only)
              (should (= (point) position))
              (should (= (point-max) end))
              (save-restriction
                (widen)
                (should (string-match-p "first\n.*second\n.*third\n\\'" (buffer-string)))))))
      (when (get-buffer fanyi-log-buffer-name) (kill-buffer fanyi-log-buffer-name)))))

(provide 'fanyi-base-tests)
