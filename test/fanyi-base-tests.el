(ert-deftest fanyi-audio-interrupted-transfer-cleans-player-and-response ()
  ;; Both writing audio and closing stdin can fail or be interrupted.
  (dolist (operation '(send eof))
    (dolist (failure '(error quit))
      (let ((fanyi--sound-task nil)
            (fanyi-sound-timeout 15)
            (fanyi-sound-player "test-player")
            (fanyi-sound-player-support-https nil)
            (fanyi-log nil)
            (fanyi-verbose nil)
            (buffer (generate-new-buffer " *fanyi-test-audio*"))
            callback player reports)
        (unwind-protect
            (cl-letf (((symbol-function 'url-retrieve)
                       (lambda (_url fn &rest _args)
                         (setq callback fn)
                         buffer))
                      ((symbol-function 'make-process)
                       (lambda (&rest args)
                         (setq player (make-pipe-process
                                       :name "fanyi-test-player"
                                       :buffer nil :noquery t
                                       :sentinel (plist-get args :sentinel)))))
                      ((symbol-function 'fanyi--report-sound-error)
                       (lambda (err) (push err reports)))
                      ((symbol-function 'process-send-region)
                       (lambda (&rest _args)
                         (when (eq operation 'send)
                           (signal failure nil))))
                      ((symbol-function 'process-send-eof)
                       (lambda (&rest _args)
                         (when (eq operation 'eof)
                           (signal failure nil)))))
              (with-current-buffer buffer
                (insert "\naudio bytes")
                (setq-local url-http-end-of-headers 1))
              (fanyi-play-sound "https://example.invalid/audio")
              (condition-case nil
                  (with-current-buffer buffer
                    (funcall callback nil))
                (quit nil))
              (should (processp player))
              (should-not (process-live-p player))
              (should (eq (process-sentinel player) #'ignore))
              (should (= (length reports) (if (eq failure 'error) 1 0)))
              (should-not (buffer-live-p buffer)))
          (when (and player (process-live-p player))
            (delete-process player))
          (when (buffer-live-p buffer)
            (kill-buffer buffer)))))))

(ert-deftest fanyi-audio-start-error-is-reported ()
  (let ((fanyi--sound-task nil)
        (fanyi-sound-timeout 15)
        (fanyi-sound-player "test-player")
        (fanyi-sound-player-support-https nil)
        (fanyi-log nil)
        (fanyi-verbose t)
        report)
    (cl-letf (((symbol-function 'url-retrieve)
               (lambda (&rest _args) (error "Cannot connect")))
              ((symbol-function 'message)
               (lambda (fmt &rest args)
                 (setq report (apply #'format fmt args)))))
      (should-not (fanyi-play-sound "https://example.invalid/audio")))
    (should (string-match-p "Cannot connect" report))))

(ert-deftest fanyi-audio-cleans-redirect-chain ()
  (fanyi-test--with-audio
    (let ((redirected (generate-new-buffer " *fanyi-test-audio-redirect*")))
      (unwind-protect
          (progn
            (fanyi-play-sound "https://example.invalid/audio")
            (with-current-buffer buffer
              (setq-local url-redirect-buffer redirected))
            (with-current-buffer redirected
              (insert "\nredirected audio")
              (setq-local url-http-end-of-headers 1)
              (funcall callback '(:redirect "https://example.invalid/new")))
            (should (equal sent "redirected audio"))
            (should-not (buffer-live-p buffer))
            (should-not (buffer-live-p redirected)))
        (when (buffer-live-p redirected)
          (kill-buffer redirected))))))

(defmacro fanyi-test--with-sound-tasks (&rest body)
  "Evaluate BODY with isolated audio state and controllable real pipe processes."
  (declare (indent 0) (debug t))
  `(let ((fanyi--sound-task nil)
         (fanyi-sound-timeout 15)
         (fanyi-sound-player "test-player")
         (fanyi-sound-player-support-https nil)
         requests players sent reports)
     (unwind-protect
         (cl-letf (((symbol-function 'url-retrieve)
                    (lambda (url callback &rest _)
                      (let* ((buffer (generate-new-buffer " *fanyi-download*"))
                             (process (make-pipe-process :name "fanyi-download" :buffer buffer
                                                         :noquery t :sentinel #'ignore)))
                        (with-current-buffer buffer
                          (insert "\n" url)
                          (setq-local url-http-end-of-headers 1))
                        (push (list url callback buffer process) requests)
                        buffer)))
                   ((symbol-function 'make-process)
                    (lambda (&rest args)
                      (let ((process (make-pipe-process :name "fanyi-player" :buffer nil :noquery t
                                                        :sentinel (plist-get args :sentinel))))
                        (push process players)
                        process)))
                   ((symbol-function 'process-send-region)
                    (lambda (process start end)
                      (push (cons process (buffer-substring-no-properties start end)) sent)))
                   ((symbol-function 'process-send-eof) #'ignore)
                   ((symbol-function 'fanyi--report-sound-error)
                    (lambda (err) (push (error-message-string err) reports))))
           ,@body)
       (fanyi-stop-sound)
       (dolist (process (append players (mapcar (lambda (request) (nth 3 request)) requests)))
         (set-process-sentinel process #'ignore)
         (when (process-live-p process) (delete-process process)))
       (dolist (request requests)
         (when (buffer-live-p (nth 2 request)) (kill-buffer (nth 2 request)))))))

(defun fanyi-test--deliver-audio (request &optional status)
  "Deliver REQUEST with STATUS, recreating cancelled buffers for late callbacks."
  (let ((buffer (nth 2 request)))
    (unless (buffer-live-p buffer)
      (setq buffer (generate-new-buffer " *fanyi-late-audio*"))
      (with-current-buffer buffer
        (insert "\n" (car request))
        (setq-local url-http-end-of-headers 1)))
    (with-current-buffer buffer (funcall (nth 1 request) status))
    (should-not (buffer-live-p buffer))))

(ert-deftest fanyi-audio-new-click-cancels-download-and-ignores-late-callbacks ()
  (fanyi-test--with-sound-tasks
    (fanyi-play-sound "https://example.invalid/first.mp3")
    (let ((first (car requests))
          (first-task fanyi--sound-task)
          (first-timer (fanyi--sound-task-timer fanyi--sound-task)))
      (should (memq first-timer timer-list))
      (fanyi-play-sound "https://example.invalid/second.mp3")
      (let ((second-task fanyi--sound-task))
        (should-not (buffer-live-p (nth 2 first)))
        (should-not (process-live-p (nth 3 first)))
        (should-not (memq first-timer timer-list))
        ;; The latest response arrives first; the old one still cannot play.
        (fanyi-test--deliver-audio (car requests))
        (fanyi-test--deliver-audio (car requests))
        (fanyi-test--deliver-audio first)
        (fanyi-test--deliver-audio first '(:error (error http 404)))
        (fanyi--sound-timeout first-task)
        (should (eq fanyi--sound-task second-task))
        (should (equal (mapcar #'cdr sent) '("https://example.invalid/second.mp3")))
        (should (= (length players) 1))
        (should-not (fanyi--sound-task-timer second-task))
        (should-not reports)))))

(ert-deftest fanyi-audio-switches-players-and-stops-pending-downloads ()
  (fanyi-test--with-sound-tasks
    (fanyi-play-sound "https://example.invalid/first.mp3")
    (fanyi-test--deliver-audio (car requests))
    (let* ((first (car players))
           (old-sentinel (process-sentinel first))
           (second (let ((fanyi-sound-player-support-https t))
                     (fanyi-play-sound "https://example.invalid/second.mp3"))))
      (should (processp second))
      (should-not (process-live-p first))
      (should (process-live-p second))
      (should (eq (process-sentinel first) #'ignore))
      (funcall old-sentinel first "killed\n")
      (should (eq (fanyi--sound-task-process fanyi--sound-task) second))
      (should-not (fanyi--sound-task-timer fanyi--sound-task))
      (call-interactively #'fanyi-stop-sound)
      (should-not fanyi--sound-task)
      (should-not (process-live-p second))
      (fanyi-play-sound "https://example.invalid/third.mp3")
      (should-not (process-live-p second))
      (let ((pending (car requests))
            (timer (fanyi--sound-task-timer fanyi--sound-task)))
        (call-interactively #'fanyi-stop-sound)
        (fanyi-stop-sound)
        (should-not fanyi--sound-task)
        (should-not (memq timer timer-list))
        (should-not (buffer-live-p (nth 2 pending)))
        (should-not (process-live-p (nth 3 pending)))
        (fanyi-test--deliver-audio pending)
        (should (= (length players) 2))
        (should-not reports)))))

(ert-deftest fanyi-audio-timeout-cancels-redirect-chain-and-reports-once ()
  (fanyi-test--with-sound-tasks
    (fanyi-play-sound "https://example.invalid/slow.mp3")
    (let* ((request (car requests))
           (task fanyi--sound-task)
           (timer (fanyi--sound-task-timer task))
           (redirect (generate-new-buffer " *fanyi-slow-redirect*"))
           (connection (make-pipe-process :name "fanyi-slow-redirect" :buffer redirect
                                          :noquery t :sentinel #'ignore)))
      (unwind-protect
          (progn
            (with-current-buffer (nth 2 request) (setq-local url-redirect-buffer redirect))
            (fanyi--sound-timeout task)
            (fanyi--sound-timeout task)
            (should-not fanyi--sound-task)
            (should-not (memq timer timer-list))
            (should-not (buffer-live-p (nth 2 request)))
            (should-not (buffer-live-p redirect))
            (should-not (process-live-p (nth 3 request)))
            (should-not (process-live-p connection))
            (should (equal reports '("Audio download timed out")))
            (fanyi-test--deliver-audio request)
            (should-not players)
            (should-not sent)
            (should (= (length reports) 1)))
        (when (buffer-live-p redirect) (kill-buffer redirect))
        (when (process-live-p connection) (delete-process connection))))))

(ert-deftest fanyi-audio-allows-disabled-timeout-and-cleans-quit-during-start ()
  (fanyi-test--with-sound-tasks
    (let ((fanyi-sound-timeout nil))
      (fanyi-play-sound "https://example.invalid/no-timeout.mp3")
      (should-not (fanyi--sound-task-timer fanyi--sound-task))
      (fanyi-stop-sound))
    (cl-letf (((symbol-function 'run-at-time) (lambda (&rest _) (keyboard-quit))))
      (should (eq 'quit (car (condition-case err
                                 (fanyi-play-sound "https://example.invalid/interrupted.mp3")
                               (quit err))))))
    (should-not fanyi--sound-task)
    (should-not (buffer-live-p (nth 2 (car requests))))
    (should-not (process-live-p (nth 3 (car requests))))
    (should-not reports)))

(ert-deftest fanyi-audio-handles-player-exit-before-process-assignment ()
  (dolist (exit-status '(0 7))
    (let ((fanyi--sound-task nil)
          (fanyi-sound-player "test-player")
          (fanyi-sound-player-support-https t)
          process reports)
      (unwind-protect
          (cl-letf (((symbol-function 'make-process)
                     (lambda (&rest args)
                       (setq process (make-pipe-process :name "fanyi-early-exit" :buffer nil
                                                        :noquery t :sentinel #'ignore))
                       (cl-letf (((symbol-function 'process-status) (lambda (_) 'exit))
                                 ((symbol-function 'process-exit-status) (lambda (_) exit-status)))
                         (funcall (plist-get args :sentinel) process "exited\n"))
                       process))
                    ((symbol-function 'fanyi--report-sound-error)
                     (lambda (err) (push err reports))))
            (let ((returned (fanyi-play-sound "https://example.invalid/direct.mp3")))
              (should (eq process returned)))
            (should-not fanyi--sound-task)
            (should-not (process-live-p process))
            (should (= (length reports) (if (zerop exit-status) 0 1))))
        (fanyi-stop-sound)
        (when (and process (process-live-p process)) (delete-process process))))))

(ert-deftest fanyi-log-formats-multiple-arguments ()
