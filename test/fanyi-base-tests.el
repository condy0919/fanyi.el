;;; fanyi-base-tests.el --- Audio and diagnostic tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'fanyi-base)

(defmacro fanyi-test--with-audio (&rest body)
  "Evaluate BODY with a mocked download and player."
  (declare (indent 0) (debug t))
  `(let ((fanyi--sound-task nil)
         (fanyi-sound-timeout 15)
         (fanyi-sound-player "test-player")
         (fanyi-sound-player-support-https nil)
         (fanyi-log nil)
         (fanyi-verbose nil)
         (buffer (generate-new-buffer " *fanyi-test-audio*"))
         callback played sent eof)
     (unwind-protect
         (cl-letf (((symbol-function 'url-retrieve)
                    (lambda (_url fn &rest _args)
                      (setq callback fn)
                      buffer))
                   ((symbol-function 'make-process)
                    (lambda (&rest _args) (setq played t) 'test-player))
                   ((symbol-function 'process-send-region)
                    (lambda (_proc start end)
                      (setq sent (buffer-substring-no-properties start end))))
                   ((symbol-function 'process-live-p) (lambda (_proc) t))
                   ((symbol-function 'process-send-eof)
                    (lambda (_proc) (setq eof t))))
           (with-current-buffer buffer
             (insert "\naudio bytes")
             (setq-local url-http-end-of-headers 1))
           ,@body)
       (fanyi-stop-sound)
       (when (buffer-live-p buffer)
         (kill-buffer buffer)))))

(ert-deftest fanyi-audio-accepts-empty-status-and-cleans-response ()
  (fanyi-test--with-audio
    (fanyi-play-sound "https://example.invalid/audio")
    (with-current-buffer buffer
      (funcall callback nil))
    (should played)
    (should (equal sent "audio bytes"))
    (should eof)
    (should-not (buffer-live-p buffer))))

(ert-deftest fanyi-audio-pipe-preserves-every-byte-regardless-of-text-coding ()
  (skip-unless (executable-find "cat"))
  (dolist (coding '(utf-8-dos utf-16le))
    (let ((fanyi--sound-task nil)
          (fanyi-sound-timeout 15)
          (fanyi-sound-player (executable-find "cat"))
          (fanyi-sound-player-support-https nil)
          (coding-system-for-write coding)
          (bytes (apply #'unibyte-string (number-sequence 0 255)))
          (make-process (symbol-function 'make-process))
          (response (generate-new-buffer " *fanyi-binary-response*"))
          process reports)
      (unwind-protect
          (with-temp-buffer
            (set-buffer-multibyte nil)
            (let ((output (current-buffer)))
              (with-current-buffer response
                (set-buffer-multibyte nil)
                (insert "\n" bytes)
                (setq-local url-http-end-of-headers 1))
              (cl-letf (((symbol-function 'url-retrieve)
                         (lambda (_url callback &rest _)
                           (with-current-buffer response (funcall callback nil))
                           response))
                        ((symbol-function 'make-process)
                         (lambda (&rest args)
                           (setq process (apply make-process (plist-put args :buffer output)))))
                        ((symbol-function 'fanyi--report-sound-error)
                         (lambda (err) (push err reports))))
                (fanyi-play-sound "https://example.invalid/audio")
                (let ((deadline (+ (float-time) 2)))
                  (while (and (process-live-p process) (< (float-time) deadline))
                    (accept-process-output process 0.05)))
                (should (eq (process-status process) 'exit))
                (should (= (process-exit-status process) 0))
                (should-not reports)
                (should-not (buffer-live-p response))
                (should (equal bytes (buffer-string))))))
        (when (and process (process-live-p process)) (delete-process process))
        (when (buffer-live-p response) (kill-buffer response))))))

(ert-deftest fanyi-audio-captures-player-and-options-before-download ()
  (fanyi-test--with-audio
    (let ((chosen-player (copy-sequence "chosen-player"))
          (options (list (copy-sequence "--stream")))
          command)
      (cl-letf (((symbol-function 'fanyi--sound-player-options)
                 (lambda (_player) options))
                ((symbol-function 'make-process)
                 (lambda (&rest args)
                   (setq command (plist-get args :command))
                   (should (plist-get args :noquery))
                   'test-player)))
        (let ((fanyi-sound-player chosen-player))
          (fanyi-play-sound "https://example.invalid/audio"))
        ;; Later configuration changes cannot affect an in-flight download.
        (aset chosen-player 0 ?X)
        (aset (car options) 0 ?X)
        (with-current-buffer buffer (funcall callback nil))
        (should (equal command '("chosen-player" "-" "--stream")))
        (should-not (buffer-live-p buffer))))))

(ert-deftest fanyi-audio-player-exit-reports-only-failure-once ()
  (let ((shell (executable-find "sh")))
    (skip-unless shell)
    (dolist (status '(0 7))
      (let ((fanyi--sound-task nil)
            (fanyi-sound-timeout 15)
            (fanyi-sound-player shell)
            (fanyi-sound-player-support-https t)
            process reports)
        (unwind-protect
            (cl-letf (((symbol-function 'fanyi--sound-player-options)
                       (lambda (_player) (list (format "exit %d" status))))
                      ((symbol-function 'fanyi--report-sound-error)
                       (lambda (err) (push (error-message-string err) reports))))
              ;; Run a real local child process without fetching audio.
              (setq process (fanyi-play-sound "-c"))
              (should (processp process))
              (should-not (process-query-on-exit-flag process))
              (let ((deadline (+ (float-time) 2)))
                (while (and (process-live-p process) (< (float-time) deadline))
                  (accept-process-output process 0.05)))
              (should (eq (process-status process) 'exit))
              (should (= (process-exit-status process) status))
              (if (zerop status)
                  (should-not reports)
                (should (= (length reports) 1))
                (should (string-match-p "code 7" (car reports)))
                ;; A second terminal notification must not duplicate the error.
                (funcall (process-sentinel process) process "exited abnormally with code 7\n")
                (should (= (length reports) 1))))
          (when (and process (process-live-p process))
            (set-process-sentinel process #'ignore)
            (delete-process process)))))))

