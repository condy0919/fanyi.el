;;; fanyi-longman-section-tests.el --- Local dictionary section folding -*- lexical-binding: t; -*-

(require 'fanyi-longman-style-tests)

(defmacro fanyi-section-test--with-response (response &rest body)
  "Render RESPONSE in a displayed Fanyi buffer, then evaluate BODY."
  (declare (indent 1) (debug (form body)))
  `(let* ((fanyi-buffer-name (generate-new-buffer-name "fanyi-section-test"))
          (fanyi-current-word "combined")
          (fanyi-use-glyphs nil)
          (shr-width 74)
          (request (fanyi-make-request fanyi-longman-provider "combined"))
          (result (fanyi-parse-response request ,response)))
     (with-temp-buffer
       (rename-buffer fanyi-buffer-name)
       (fanyi-mode)
       (save-window-excursion
         (set-window-buffer nil (current-buffer))
         (fanyi-render-result request result)
         (let ((noninteractive nil)) (font-lock-mode 1))
         (font-lock-ensure)
         ,@body))))

(defun fanyi-section-test--position (text)
  "Return the start of TEXT without moving point."
  (save-excursion
    (let ((case-fold-search nil))
      (goto-char (point-min))
      (search-forward text)
      (match-beginning 0))))

(defun fanyi-section-test--toggle (heading)
  "Activate the section button on HEADING."
  (let ((button (button-at (fanyi-section-test--position heading))))
    (should button)
    (should (eq (button-get button 'action) #'fanyi-shr-toggle-section))
    (button-activate button)))

(defun fanyi-section-test--visible (texts visible)
  "Assert that each of TEXTS has visibility VISIBLE."
  (dolist (text texts)
    (ert-info ((format "Expected %S to be %s" text (if visible "visible" "hidden")))
      (should (eq (not (invisible-p (fanyi-section-test--position text))) visible)))))

(defun fanyi-section-test--combined-response ()
  "Place the real sun and explode boxes between consecutive definitions."
  (let ((sun (fanyi-test--read-fixture "longman-sun-saved.html"))
        (explode (fanyi-test--read-fixture "longman-explode-saved.html")))
    `(html nil
           (body nil
                 (div ((class . "dictionary"))
                      (span ((class . "dictentry"))
                            (span ((class . "ldoceEntry Entry"))
                                  (span ((class . "Head"))
                                        (span ((class . "HYPHENATION")) "combined")
                                        (span ((class . "speaker brefile")
                                               (data-src-mp3 . "https://example.invalid/combined.mp3"))))
                                  (span ((class . "Sense"))
                                        (span ((class . "DEF")) "Introductory definition."))
                                  ,(copy-tree (car (dom-by-class sun "^ColloBox$")))
                                  (span ((class . "Sense"))
                                        (span ((class . "DEF")) "Definition between sections."))
                                  ,(copy-tree (car (dom-by-class explode "^ThesBox$")))
                                  (span ((class . "Sense"))
                                        (span ((class . "DEF")) "Definition after thesaurus."))
                                  (div ((class . "corpus"))
                                       (span ((class . "asset_intro")) "Examples from the Corpus")
                                       (span ((class . "title")) "combined")
                                       (span ((class . "exa")) "Corpus stays visible."))))
                      (div ((class . "etym"))
                           (span ((class . "asset_intro")) "Origin")
                           (span ((class . "HWD")) "combined")
                           (span ((class . "ORIGIN")) "Latin.")))))))

(ert-deftest fanyi-longman-section-sun-composite-heading-folds-only-collocations ()
  (fanyi-section-test--with-response
      (fanyi-test--read-fixture "longman-sun-saved.html")
    (let* ((heading "COLLOCATIONS – Meanings 1 & 2")
           (start (fanyi-section-test--position heading))
           (button (button-at start))
           (body '("VERBS" "the sun beats down/blazes down" "the sun’s rays"
                   "This moisturiser will also protect skin from the sun’s rays."))
           (outside '("## Examples from the Corpus sun" "a distant sun"
                      "Origin sun" "sun2 verb" "the written abbreviation of Sunday"))
           (before (buffer-substring-no-properties (point-min) (point-max))))
      (should button)
      (should (equal (buffer-substring-no-properties (button-start button) (button-end button))
                     heading))
      (should (= (button-start (button-at (+ start (1- (length heading)))))
                 (button-start button)))
      (fanyi-section-test--visible body t)
      (fanyi-section-test--toggle heading)
      (fanyi-section-test--visible body nil)
      (fanyi-section-test--visible (cons heading outside) t)
      (font-lock-flush)
      (font-lock-ensure)
      (fanyi-section-test--visible body nil)
      (fanyi-section-test--toggle heading)
      (fanyi-section-test--visible body t)
      (should (equal (buffer-substring-no-properties (point-min) (point-max)) before)))))

(ert-deftest fanyi-longman-section-explode-keeps-register-corpus-and-origin-visible ()
  (fanyi-section-test--with-response
      (fanyi-test--read-fixture "longman-explode-saved.html")
    (let ((body '("TO EXPLODE" "TO MAKE SOMETHING EXPLODE"
                  "He struck a match and blew the whole place up."))
          (outside '("Register" "In everyday English," "A bomb went off in the city centre."
                     "INCREASE SUDDENLY" "## Examples from the Corpus explode"
                     "If you roll a misfire" "Origin explode")))
      (should-not (button-at (fanyi-section-test--position "Register")))
      (fanyi-section-test--visible body t)
      (fanyi-section-test--toggle "THESAURUS")
      (fanyi-section-test--visible body nil)
      (fanyi-section-test--visible (cons "THESAURUS" outside) t)
      (fanyi-section-test--toggle "THESAURUS")
      (fanyi-section-test--visible body t))))

(ert-deftest fanyi-longman-sections-toggle-independently-with-precise-boundaries ()
  (fanyi-section-test--with-response (fanyi-section-test--combined-response)
    (let ((outside '("Introductory definition." "Definition between sections."
                     "Definition after thesaurus." "Corpus stays visible." "Origin combined")))
      (dolist (state '(("COLLOCATIONS" nil t)
                       ("THESAURUS" nil nil)
                       ("COLLOCATIONS" t nil)
                       ("THESAURUS" t t)))
        (fanyi-section-test--toggle (car state))
        (fanyi-section-test--visible '("the sun shines" "the sun’s rays") (cadr state))
        (fanyi-section-test--visible '("TO EXPLODE" "TO MAKE SOMETHING EXPLODE") (caddr state))
        (fanyi-section-test--visible (append '("COLLOCATIONS" "THESAURUS") outside) t)))))

(ert-deftest fanyi-longman-section-titleless-box-and-nested-heading-keep-content ()
  (let* ((dom (fanyi-section-test--combined-response))
         (collocations (car (dom-by-class dom "^ColloBox$")))
         (thesaurus (car (dom-by-class dom "^ThesBox$"))))
    ;; A partial response may lack a box's title while retaining useful entries.
    (dolist (child (copy-sequence (dom-non-text-children collocations)))
      (when (or (member "heading" (split-string (or (dom-attr child 'class) "")))
                (member "HEADING" (split-string (or (dom-attr child 'class) ""))))
        (dom-remove-node collocations child)))
    (dom-append-child (car (dom-by-class thesaurus "^Exponent$"))
                      '(span ((class . "HEADING")) "Nested body heading"))
    (fanyi-section-test--with-response dom
      (should-not (string-match-p "COLLOCATIONS" (buffer-string)))
      (fanyi-section-test--visible '("the sun shines" "Nested body heading") t)
      (let ((button (button-at (fanyi-section-test--position "THESAURUS"))))
        (should button)
        (should (equal (buffer-substring-no-properties (button-start button) (button-end button))
                       "THESAURUS")))
      (fanyi-section-test--toggle "THESAURUS")
      (fanyi-section-test--visible '("Nested body heading") nil)
      (fanyi-section-test--visible '("the sun shines" "Definition after thesaurus.") t))))

(ert-deftest fanyi-longman-section-reflow-retains-state-reading-position-and-actions ()
  (let (queries played)
    (cl-letf (((symbol-function 'url-retrieve)
               (lambda (&rest _) (ert-fail "Section operations must stay offline")))
              ((symbol-function 'url-retrieve-synchronously)
               (lambda (&rest _) (ert-fail "Section operations must stay offline")))
              ((symbol-function 'url-queue-retrieve)
               (lambda (&rest _) (ert-fail "Section operations must stay offline")))
              ((symbol-function 'fanyi-dwim) (lambda (word) (push word queries)))
              ((symbol-function 'fanyi-play-sound) (lambda (url) (push url played))))
      (fanyi-section-test--with-response (fanyi-section-test--combined-response)
        (let ((links (fanyi-test--button-data #'fanyi-dwim))
              (audio (fanyi-test--button-data #'fanyi-play-sound))
              (before (replace-regexp-in-string "[ \t\r\n]+" " " (buffer-string))))
          (fanyi-section-test--toggle "COLLOCATIONS")
          (goto-char (fanyi-section-test--position "Definition after thesaurus."))
          (set-window-start nil (line-beginning-position) t)
          (let ((shr-width 42))
            (fanyi-shr-reflow))
          (should (looking-at-p "Definition after thesaurus\\."))
          (font-lock-flush)
          (font-lock-ensure)
          (fanyi-section-test--visible '("the sun shines" "the sun’s rays") nil)
          (fanyi-section-test--visible '("TO EXPLODE" "TO MAKE SOMETHING EXPLODE"
                                         "Definition between sections." "Definition after thesaurus."
                                         "Corpus stays visible." "Origin combined") t)
          (should (equal (fanyi-test--button-data #'fanyi-dwim) links))
          (should (equal (fanyi-test--button-data #'fanyi-play-sound) audio))
          (should (equal (replace-regexp-in-string "[ \t\r\n]+" " " (buffer-string)) before))
          (fanyi-section-test--toggle "COLLOCATIONS")
          (fanyi-section-test--visible '("the sun shines") t)
          (button-activate (fanyi-test--longman-style-button "bomb"))
          (let ((position (point-min)) button)
            (while (and (setq button (next-button position t))
                        (not (eq (button-get button 'action) #'fanyi-play-sound)))
              (setq position (button-end button)))
            (should button)
            (button-activate button))
          (should (equal queries '("bomb")))
          (should (equal played '("https://example.invalid/combined.mp3"))))))))

(provide 'fanyi-longman-section-tests)
;;; fanyi-longman-section-tests.el ends here
